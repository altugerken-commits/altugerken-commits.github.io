---
// PLACEHOLDER HANDLES. These follow the conventional `altugerken` pattern and
// have NOT been verified against real profiles — they are stand-ins for the
// bare site roots that were here before. Confirm all three before this goes
// live: a link to the wrong person's profile is worse than no link at all.
const socials = [
  ['Behance', 'https://www.behance.net/altugerken'],
  ['LinkedIn', 'https://www.linkedin.com/in/altugerken'],
  ['Instagram', 'https://www.instagram.com/altugerken'],
  ['Email', 'mailto:altug.erken@ozu.edu.tr'],
];
---

<section class="ct" id="contact">
  <div class="ct__inner">
    <p class="hud ct__eyebrow">Contact<i class="sep">/</i>Open for commissions</p>

    <h2 class="ct__line serif" data-reveal>
      Tell me what cannot happen.
    </h2>

    <p class="ct__body serif" data-reveal data-w="0.5">
      Send the constraints — the tolerance, the tooling, the cost ceiling,
      the thing everyone says is impossible. That is the interesting part.
    </p>

    <a class="ct__mail serif" href="mailto:altug.erken@ozu.edu.tr" data-mag>
      altug.erken@ozu.edu.tr
    </a>

    <hr class="rule ct__rule" />

    <ul class="ct__soc">
      {socials.map(([name, href]) => (
        <li>
          <a class="hud ct__lnk" href={href} data-mag rel="noopener noreferrer" target={href.startsWith('mailto') ? null : '_blank'}>
            {name}
          </a>
        </li>
      ))}
    </ul>

    <footer class="ct__foot">
      <p class="hud hud--faint">
        Altug Erken<i class="sep">/</i><span lang="tr">Altuğ Erken</span><i class="sep">/</i>
        <span lang="tr">İstanbul</span>
      </p>
      <p class="hud hud--faint">Industrial Design<i class="sep">/</i>© 2026</p>
    </footer>
  </div>
</section>

<style>
  .ct {
    position: relative;
    z-index: var(--z-section);
    padding: clamp(6rem, 20vh, 14rem) clamp(1.1rem, 6vw, 7rem) clamp(3rem, 8vh, 5rem);
  }
  .ct__inner { max-width: 68rem; margin-inline: auto; }
  .ct__eyebrow { margin-bottom: clamp(3rem, 10vh, 6rem); }

  .ct__line {
    margin: 0 0 clamp(1.75rem, 5vh, 3rem);
    font-size: var(--text-d1);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .ct__body {
    margin: 0 0 clamp(3rem, 9vh, 5.5rem);
    max-width: 34rem;
    font-size: var(--text-d3);
    line-height: 1.55;
    color: var(--ink-mute);
  }

  .ct__mail {
    display: inline-block;
    font-size: var(--text-d2);
    letter-spacing: -0.02em;
    color: var(--ink-dim);
    text-decoration: none;
    background-image: linear-gradient(var(--pa), var(--pa));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: color 700ms var(--ease), background-size 900ms var(--ease);
  }
  .ct__mail:hover, .ct__mail:focus-visible { color: var(--ink); background-size: 100% 1px; }

  .ct__rule { margin: clamp(4rem, 12vh, 7rem) 0 1.75rem; }

  .ct__soc { list-style: none; display: flex; flex-wrap: wrap; gap: clamp(1.25rem, 4vw, 3rem); margin: 0 0 clamp(4rem, 12vh, 7rem); padding: 0; }
  .ct__lnk { color: var(--ink-mute); text-decoration: none; transition: color 600ms var(--ease); }
  .ct__lnk:hover, .ct__lnk:focus-visible { color: var(--pa); }

  .ct__foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
</style>
