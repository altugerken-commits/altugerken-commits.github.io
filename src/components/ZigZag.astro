---
import { projects } from '../data/projects';
---

<section class="zz" id="work">
  <div class="zz__head">
    <p class="hud">Selected Work<i class="sep">/</i>Eight Projects</p>
    <hr class="rule" />
  </div>

  {projects.map((p, i) => (
    <article
      class:list={['zz__row', i % 2 === 0 ? 'zz__row--l' : 'zz__row--r']}
      data-project={p.slug}
      data-accent={p.accent}
      data-on-dark={p.onDark}
      data-on-light={p.onLight}
      data-model={p.model ?? ''}
      style={`--pd:${p.onDark};--pl:${p.onLight};--praw:${p.accent}`}
    >
      <a class="zz__tab bracket" href={`/work/${p.slug}`} data-tab data-mag={false}>
        <span class="zz__meta hud hud--faint">{p.year}</span>

        <h2 class="zz__title serif">{p.title}</h2>

        <p class="zz__sub hud">{p.subtitle}</p>

        <span class="zz__mat hud hud--faint">
          <span class="zz__chip" aria-hidden="true"></span>{p.material}
        </span>

        <span class="zz__rule" aria-hidden="true"></span>
      </a>
    </article>
  ))}
</section>

<style>
  .zz {
    position: relative;
    z-index: var(--z-section);
    padding: clamp(6rem, 20vh, 14rem) clamp(1.1rem, 6vw, 7rem) clamp(8rem, 24vh, 16rem);
  }
  .zz__head { max-width: 90rem; margin: 0 auto clamp(4rem, 14vh, 9rem); }
  .zz__head .rule { margin-top: 1.1rem; }

  .zz__row {
    max-width: 90rem;
    margin-inline: auto;
    display: flex;
    /* the zig-zag: alternating sides, with a deliberate 8% inset so the
       eye travels rather than scanning a column */
    padding-block: clamp(3rem, 11vh, 8rem);
  }
  .zz__row--l { justify-content: flex-start; padding-right: 8%; }
  .zz__row--r { justify-content: flex-end; padding-left: 8%; }

  .zz__tab {
    display: grid;
    gap: 0.55rem;
    width: min(38rem, 100%);
    padding: clamp(1.4rem, 3vw, 2.4rem);
    text-decoration: none;
    color: inherit;
    /* accent resolves per theme; the raw material hex drives WebGL only */
    --pa: var(--pd);
  }
  :global([data-theme="light"]) .zz__tab { --pa: var(--pl); }

  .zz__row--r .zz__tab { text-align: right; justify-items: end; }

  .zz__title {
    margin: 0;
    font-size: var(--text-d1);
    line-height: 0.98;
    letter-spacing: -0.028em;
    color: var(--ink-dim);
    transition: color 800ms var(--ease);
  }
  .zz__tab:hover .zz__title,
  .zz__tab:focus-visible .zz__title { color: var(--ink); }

  .zz__sub { color: var(--ink-mute); }

  .zz__mat { display: inline-flex; align-items: center; gap: 0.6em; }
  .zz__chip {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--praw);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--ink) 22%, transparent);
    flex: none;
    transition: box-shadow 700ms var(--ease), transform 700ms var(--ease);
  }
  .zz__tab:hover .zz__chip { transform: scale(1.5); box-shadow: 0 0 22px 2px var(--praw); }

  /* the hairline that draws in on hover — the 5% doing the work */
  .zz__rule {
    height: 1px;
    margin-top: 0.9rem;
    background: var(--pa);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 900ms var(--ease);
  }
  .zz__row--r .zz__rule { transform-origin: right center; }
  .zz__tab:hover .zz__rule,
  .zz__tab:focus-visible .zz__rule { transform: scaleX(1); }

  @media (max-width: 820px) {
    .zz__row--l, .zz__row--r { padding-inline: 0; justify-content: flex-start; }
    .zz__row--r .zz__tab { text-align: left; justify-items: start; }
    .zz__row--r .zz__rule { transform-origin: left center; }
  }
</style>

<script>
  // Hovering a tab retargets the stage: the light rig crossfades to that
  // project's exact material hex and the page's live accent follows.
  const rows = [...document.querySelectorAll<HTMLElement>('.zz__row')];
  const root = document.documentElement;

  const retarget = (row: HTMLElement) => {
    const raw = row.dataset.accent;
    const dark = row.dataset.onDark;
    const light = row.dataset.onLight;
    if (!raw) return;
    root.style.setProperty('--pa-raw', raw);
    root.style.setProperty('--pa', root.dataset.theme === 'light' ? (light || raw) : (dark || raw));
    document.dispatchEvent(new CustomEvent('projectaccent', { detail: { accent: raw, slug: row.dataset.project } }));

    // Preload the model the moment intent is shown, so the click is instant.
    const m = row.dataset.model;
    if (m && (window as any).__stageLoad) (window as any).__stageLoad(m).catch(() => {});
  };

  rows.forEach((row) => {
    const tab = row.querySelector<HTMLElement>('.zz__tab');
    tab?.addEventListener('pointerenter', () => retarget(row));
    tab?.addEventListener('focus', () => retarget(row));
  });

  // Whichever row is nearest the viewport centre owns the accent while
  // scrolling, so the thread never sits on a stale colour.
  if (rows.length) {
    const io = new IntersectionObserver(
      (es) => {
        const best = es.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (best) retarget(best.target as HTMLElement);
      },
      { rootMargin: '-40% 0px -40% 0px', threshold: [0, 0.5, 1] }
    );
    rows.forEach((r) => io.observe(r));
  }
</script>
