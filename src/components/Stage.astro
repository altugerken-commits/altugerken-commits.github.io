---
// THE STAGE — persistent WebGL model container.
//
// Infrastructure, deliberately. No models exist yet; this is the socket they
// drop into. Hovering a project tab retargets the stage: the light rig
// crossfades to that project's exact material hex and the proxy volume
// re-forms. When a real model arrives it is a one-line change — put
// <slug>.glb in public/models/ and set `model` in src/data/projects.ts.
//
// GLB, not FBX: FBX carries no compression, and a previous 86MB export
// arrived as 1,498 meshes / 3.6M triangles. The loader below expects Draco-
// compressed GLB and reports mesh/triangle counts on load so the budget is
// never a surprise again.
---

<!-- transition:persist carries the initialised renderer, its WebGL context and
     the live __stageLoad closure across client-side navigation. The element is
     absolutely positioned against whichever container it lands in, and resize()
     re-reads that container every frame, so the same canvas re-fits itself from
     the hero to a project page's stage box without being rebuilt. -->
<div class="stage" data-stage transition:persist="stage" aria-hidden="true">
  <canvas class="stage__cv" data-stage-cv></canvas>
  <p class="hud hud--faint stage__note" data-stage-note>( Stage ready · awaiting model )</p>
</div>

<style>
  .stage {
    position: absolute;
    inset: 0;
    z-index: var(--z-stage);
    pointer-events: none;
  }
  .stage__cv {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1800ms var(--ease);
  }
  .stage__cv[data-ready] { opacity: 1; }
  .stage__note {
    position: absolute;
    left: 50%;
    bottom: 8%;
    transform: translateX(-50%);
    opacity: 0.55;
    transition: opacity 900ms var(--ease);
    white-space: nowrap;
  }
  .stage__note[data-hide] { opacity: 0; }
</style>

<script>
  import { onFrame, view, damp } from '../lib/loop';

  const host = document.querySelector<HTMLElement>('[data-stage]');
  const cv = document.querySelector<HTMLCanvasElement>('[data-stage-cv]');
  const note = document.querySelector<HTMLElement>('[data-stage-note]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Heavy real-time geometry is a desktop affordance. Phones get the type.
  const capable = matchMedia('(min-width: 1024px) and (pointer: fine)').matches;

  // The socket ALWAYS exists, even where WebGL is gated off, so callers
  // (hover preloads, project pages) can never throw on a missing global.
  // The real loader replaces this once three.js is up.
  if (!(window as any).__stageLoad) {
    (window as any).__stageLoad = async () =>
      ({ deferred: true, reason: capable ? 'stage still initialising' : 'webgl gated off on this device' });
  }

  // ---- what does THIS page want staged? --------------------------------
  // The stage element persists across navigation and component <script>
  // modules do not re-execute after a swap, so nothing page-specific can be
  // decided at module scope. The stage is on every page, so it owns the
  // decision rather than each page pushing into it — a page script only ever
  // registers if that page happened to be the entry point.
  const readWant = () =>
    document.querySelector<HTMLElement>('[data-hero-model]')?.dataset.heroModel ||
    document.querySelector<HTMLElement>('.pj')?.dataset.model ||
    '';

  let want = readWant();
  const applyWant = () => (window as any).__stageShow?.(want);
  applyWant();
  document.addEventListener('astro:page-load', () => { want = readWant(); applyWant(); });

  if (host && cv && capable) {
    (async () => {
      const THREE = await import('three');
      const { RoomEnvironment } = await import('three/examples/jsm/environments/RoomEnvironment.js');

      const renderer = new THREE.WebGLRenderer({ canvas: cv, antialias: true, alpha: true, powerPreference: 'high-performance' });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.1;

      const scene = new THREE.Scene();
      const pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

      const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 100);

      // Rim light is the only thing that carves a dark object out of a dark
      // ground. It carries the project's exact accent hex.
      const key = new THREE.DirectionalLight(0xffffff, 2.0);
      key.position.set(4, 5.5, 7);
      scene.add(key);
      const rim = new THREE.DirectionalLight(0xffffff, 5.0);
      rim.position.set(-7, 3, -6);
      scene.add(rim);
      const rim2 = new THREE.DirectionalLight(0xffffff, 2.4);
      rim2.position.set(7, 1.5, -7);
      scene.add(rim2);
      scene.add(new THREE.AmbientLight(0x2a3a5c, 1.0));

      const root = new THREE.Group();
      scene.add(root);

      // Proxy volume — a placeholder that reads as "an object is staged here"
      // without pretending to be anyone's product.
      const proxyMat = new THREE.MeshPhysicalMaterial({
        color: 0x0d1018, metalness: 0.5, roughness: 0.28,
        clearcoat: 0.7, clearcoatRoughness: 0.15, envMapIntensity: 1.3,
        transparent: true, opacity: 0.92,
      });
      const proxy = new THREE.Mesh(new THREE.IcosahedronGeometry(1.9, 3), proxyMat);
      root.add(proxy);

      const wire = new THREE.LineSegments(
        new THREE.EdgesGeometry(new THREE.IcosahedronGeometry(2.35, 1), 18),
        new THREE.LineBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.18 })
      );
      root.add(wire);

      let loaded: any = null;
      let staged = '';   // url currently on the stage — '' means the proxy volume

      const resize = () => {
        const w = host.clientWidth || 1, h = host.clientHeight || 1;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.position.set(0, 0.2, w / h < 1.1 ? 11 : 8.6);
        camera.lookAt(0, 0, 0);
        camera.updateProjectionMatrix();
      };
      resize();
      addEventListener('resize', resize, { passive: true });

      // ---- retarget: hovering a project tab drives this
      const col = new THREE.Color('#FF5E00');
      const target = new THREE.Color('#FF5E00');
      document.addEventListener('projectaccent', (e: any) => {
        if (e.detail?.accent) target.set(e.detail.accent);
      });

      // ---- model socket. Drop <slug>.glb into public/models/.
      (window as any).__stageLoad = async (url: string) => {
        staged = url;
        const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
        const { DRACOLoader } = await import('three/examples/jsm/loaders/DRACOLoader.js');
        const gl = new GLTFLoader();
        const dr = new DRACOLoader();
        dr.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.7/');
        gl.setDRACOLoader(dr);
        return new Promise((res, rej) => {
          gl.load(url, (g) => {
            if (loaded) { root.remove(loaded); }
            proxy.visible = false; wire.visible = false;
            let tris = 0, meshes = 0;
            g.scene.traverse((c: any) => {
              if (!c.isMesh) return;
              meshes++;
              const ge = c.geometry;
              tris += (ge.index ? ge.index.count : ge.attributes.position.count) / 3;
            });
            const box = new THREE.Box3().setFromObject(g.scene);
            const size = box.getSize(new THREE.Vector3());
            const ctr = box.getCenter(new THREE.Vector3());
            const s = 5.6 / (Math.max(size.x, size.y, size.z) || 1);
            g.scene.scale.setScalar(s);
            g.scene.position.copy(ctr.multiplyScalar(-s));
            loaded = g.scene;
            root.add(loaded);
            note?.setAttribute('data-hide', '');
            const info = { meshes, triangles: Math.round(tris) };
            (window as any).__stageInfo = info;
            res(info);
          }, undefined, rej);
        });
      };

      let px = 0, py = 0, cx = 0, cy = 0;
      if (!reduced) {
        addEventListener('pointermove', (e) => {
          px = (e.clientX / innerWidth) * 2 - 1;
          py = (e.clientY / innerHeight) * 2 - 1;
        }, { passive: true });
      }

      let vis = true;
      new IntersectionObserver(([e]) => { vis = e.isIntersecting; }, { rootMargin: '120px' }).observe(host);

      onFrame((t, dt) => {
        if (!vis) return;
        resize();

        col.lerp(target, 1 - Math.exp(-2.2 * dt));
        rim.color.copy(col);
        rim2.color.copy(col).lerp(new THREE.Color('#ffffff'), 0.55);
        (wire.material as any).color.copy(col);

        cx = damp(cx, px, 3.0, dt);
        cy = damp(cy, py, 3.0, dt);

        // The LIGHT tracks the pointer; the object holds its ground.
        key.position.set(cx * 8 + 3, -cy * 5 + 5, 7.5);
        rim.intensity = reduced ? 5.0 : 5.0 + Math.sin(t * 0.3) * 0.4;

        const o = loaded || root;
        o.rotation.y = -0.55 + cx * 0.1 + view.progress * 0.5;
        o.rotation.x = 0.05 + cy * 0.03;
        if (!loaded) { proxy.rotation.y = t * 0.08; wire.rotation.y = -t * 0.05; }
        root.position.y = reduced ? 0 : Math.sin(t * 0.35) * 0.05;

        renderer.render(scene, camera);
      });

      // Page-level staging. Hovering a tab still drives __stageLoad directly —
      // that is a deliberate retarget within a page. This is the other axis:
      // "this page wants this object, or none at all". An empty url returns the
      // stage to its proxy volume rather than leaving the previous project's
      // model sitting under the wrong title.
      (window as any).__stageShow = (url: string) => {
        if (url === staged) return;
        if (!url) {
          staged = '';
          if (loaded) { root.remove(loaded); loaded = null; }
          proxy.visible = true;
          wire.visible = true;
          (window as any).__stageInfo = null;
          note?.removeAttribute('data-hide');
          return;
        }
        (window as any).__stageLoad(url).catch(() => {});
      };

      cv.setAttribute('data-ready', '');

      // Stage whatever the page asked for while three.js was still loading.
      applyWant();
    })();
  } else if (note) {
    note.setAttribute('data-hide', '');
  }
</script>
