---
// THE STAGE — blank.
//
// This is the engine, kept deliberately empty. It brings up a WebGL2 renderer,
// a perspective camera positioned for Z-axis travel, a resize handler and a
// Draco-ready GLB loader, then stops. There is no lighting rig, no material
// language, no composition — those are design decisions, and they are yours.
//
// Carried over from the previous build because they were hard-won, not because
// of how anything looked:
//   - one clock. Everything registers with lib/loop.ts; nothing owns a private
//     rAF. Five competing loops is how a "continuous flow" turns into parts
//     that visibly disagree.
//   - transition:persist. Component <script> modules do not re-execute after a
//     ClientRouter swap, so without it the initialised context is replaced by a
//     blank canvas on the first internal navigation.
//   - the Draco decoder path, which is what the two existing .glb files in
//     public/models are compressed with.
//
// Everything hangs off window.__scene so the next step can attach to it
// without this file needing to know anything about that scene.
---

<canvas class="stage-canvas" data-stage transition:persist="stage"></canvas>

<script>
  import { onFrame, view, ticks as clockTicks } from '../lib/loop';

  const cv = document.querySelector<HTMLCanvasElement>('[data-stage]');

  if (cv) {
    (async () => {
      const THREE = await import('three');

      const renderer = new THREE.WebGLRenderer({
        canvas: cv,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance',
      });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      // ACESFilmic + sRGB so emissive/bloom-heavy scenes have somewhere to go
      // without clipping. Swap freely once the look is decided.
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.0;
      renderer.outputColorSpace = THREE.SRGBColorSpace;

      const scene = new THREE.Scene();

      // ---- flat product lighting -------------------------------------------
      // A PMREM RoomEnvironment used to live here. It lit the models correctly
      // but it is an IMAGE of a room — every glossy material sampled it and
      // produced hard specular hotspots and window reflections, which is
      // exactly the glare that had to die.
      //
      // Two punctual lights instead. An environment map cannot be made matte
      // by tuning; a light rig can. Ambient does almost all the work so the
      // result is near-flat, and the directional exists only to keep the form
      // from reading as a silhouette. No shadows: shadow maps would add
      // contrast, which is the opposite of the brief.
      // Intensities are bounded by the BLOOM THRESHOLD, not by taste. Bloom
      // lifts anything above ~0.8 linear, so a diffuse surface lit past that
      // gains a soft halo — which reads as glare just as much as a specular
      // hotspot does, even though the material has no specular term at all.
      // Total light is held near 1.0 so albedo * light stays under the
      // threshold for every material in these assets.
      const ambient = new THREE.AmbientLight(0xffffff, 0.72);
      scene.add(ambient);

      // Diffuse-only shading needs *some* direction or the products read as
      // flat cut-outs. Kept low, and shadowless: shadow maps add contrast,
      // which is the opposite of the brief.
      const key = new THREE.DirectionalLight(0xffffff, 0.34);
      key.position.set(2.5, 4, 3);
      key.castShadow = false;
      scene.add(key);

      // A second, dimmer light from below-behind lifts the underside so the
      // lower half of a product does not fall to black.
      const fill = new THREE.DirectionalLight(0xffffff, 0.16);
      fill.position.set(-3, -2, -2.5);
      fill.castShadow = false;
      scene.add(fill);

      // 50° vertical FOV and a deep far plane: enough perspective for depth
      // travel to read, without the fisheye that comes from going much wider.
      const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 2000);
      camera.position.set(0, 0, 12);

      const resize = () => {
        // clientWidth, not innerWidth. innerWidth includes the classic
        // scrollbar gutter, but the canvas lays out at 100% of the content box
        // without it — so the drawing buffer was ~15px wider than the element
        // and every frame rendered at a ~1% horizontal squash whenever a
        // scrollbar was present, which on this site is always.
        const w = cv.clientWidth || innerWidth || 1;
        const h = cv.clientHeight || innerHeight || 1;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      };
      resize();
      addEventListener('resize', resize, { passive: true });

      // Pointer in normalised device coords, damped by whoever consumes it.
      const pointer = new THREE.Vector2(0, 0);
      addEventListener(
        'pointermove',
        (e) => {
          pointer.x = (e.clientX / innerWidth) * 2 - 1;
          pointer.y = -((e.clientY / innerHeight) * 2 - 1);
        },
        { passive: true },
      );

      // ---- Draco-ready GLB loader ------------------------------------------
      let gltfLoader: any = null;
      const loadGLB = async (url: string) => {
        if (!gltfLoader) {
          const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
          const { DRACOLoader } = await import('three/examples/jsm/loaders/DRACOLoader.js');
          // Both codecs are wired, because both are in use: the original
          // Blender exports ship KHR_draco_mesh_compression, and everything
          // through the @gltf-transform/cli pipeline ships
          // EXT_meshopt_compression. A loader missing either one fails at load
          // with a bare "decoder must be called before loading compressed
          // files" rather than degrading, so there is no silent fallback path.
          const { MeshoptDecoder } = await import(
            'three/examples/jsm/libs/meshopt_decoder.module.js'
          );
          gltfLoader = new GLTFLoader();
          const draco = new DRACOLoader();
          draco.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.7/');
          gltfLoader.setDRACOLoader(draco);
          gltfLoader.setMeshoptDecoder(MeshoptDecoder);
        }
        const gltf: any = await gltfLoader.loadAsync(url);
        let meshes = 0;
        let triangles = 0;
        gltf.scene.traverse((c: any) => {
          if (!c.isMesh) return;
          meshes++;
          const g = c.geometry;
          triangles += (g.index ? g.index.count : g.attributes.position.count) / 3;
        });
        return { gltf, root: gltf.scene, meshes, triangles: Math.round(triangles) };
      };

      // ---- the tick --------------------------------------------------------
      // Subscribers run before the draw, in registration order. Returning the
      // unsubscribe keeps scene swaps from leaking callbacks.
      type Tick = (t: number, dt: number) => void;
      const tickFns = new Set<Tick>();
      const onTick = (fn: Tick) => {
        tickFns.add(fn);
        return () => tickFns.delete(fn);
      };

      // A scene may take over the draw — the stencil mask renders the world to
      // a target and composites it through type, so it cannot use the plain
      // path. Returns a disposer that restores direct rendering.
      let renderOverride: ((t: number, dt: number) => void) | null = null;
      const setRenderOverride = (fn: (t: number, dt: number) => void) => {
        renderOverride = fn;
        return () => { renderOverride = null; };
      };

      onFrame((t, dt) => {
        resize();
        for (const fn of tickFns) fn(t, dt);
        if (renderOverride) renderOverride(t, dt);
        else renderer.render(scene, camera);
      });

      // Post-processing seam: chromatic aberration, glitch and bloom belong in
      // an EffectComposer that replaces the renderer.render call above. Left
      // unbuilt on purpose — it is a look decision, not scaffolding.

      (window as any).__scene = {
        THREE,
        scene,
        camera,
        renderer,
        pointer,
        view,        // shared scroll progress, written once per frame
        loadGLB,
        onTick,
        setRenderOverride,
        clockTicks,  // frames driven since load; 0 after a second means a dead clock
        ready: true,
      };

      cv.setAttribute('data-ready', '');
      document.dispatchEvent(new CustomEvent('stage:ready'));
    })();
  }
</script>
