---
// THE STUDIO.
//
// A WebGL2 renderer, a long-lens camera, a three-source studio rig and a
// GLB loader. That is the whole engine; staging is the scenes' business.
//
// What changed with the direction, and why:
//
//   - alpha:true is now load-bearing rather than incidental. The canvas is
//     genuinely transparent, so the paper ground in CSS shows through it and
//     the products sit ON the page. Nothing here draws a background; if this
//     file ever clears to a colour, the illusion dies.
//
//   - NO EffectComposer. Bloom belonged to a scene made of emissive light in
//     a void. On a paper ground bloom is actively wrong — it hazes the page
//     and lifts the blacks of the product. Rendering direct also deletes the
//     entire class of bugs that came from render targets and pass ordering.
//
//   - NeutralToneMapping, not ACESFilmic. ACES is a film curve: it warms and
//     desaturates the top end, which is what you want for emissive spectacle
//     and exactly what you do not want when the job is showing an object's
//     real material colour on white. Khronos PBR Neutral is built for product
//     viewing and holds hue as it approaches white.
//
//   - The rig is soft and frontal, and the products stay Lambert. Diffuse-only
//     shading cannot produce a specular hotspot at any brightness, which keeps
//     the zero-glare guarantee structural rather than a tuning result. It also
//     happens to be the brief: dead-front, monochrome, raw materiality.
//
// Everything hangs off window.__scene.
---

<canvas class="stage-canvas" data-stage transition:persist="stage"></canvas>

<script>
  import { onFrame, view, ticks as clockTicks } from '../lib/loop';

  const cv = document.querySelector<HTMLCanvasElement>('[data-stage]');

  if (cv) {
    (async () => {
      const THREE = await import('three');

      const renderer = new THREE.WebGLRenderer({
        canvas: cv,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance',
      });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.setClearAlpha(0);
      renderer.toneMapping = THREE.NeutralToneMapping;
      renderer.toneMappingExposure = 1.0;
      renderer.outputColorSpace = THREE.SRGBColorSpace;

      const scene = new THREE.Scene();

      // ---- the studio rig ---------------------------------------------------
      // Three sources, all soft, all shadowless. Shadow maps are deliberately
      // absent: a cast shadow is a hard edge and this direction has none. The
      // products are grounded instead by a painted contact shadow underneath
      // them, which is both softer and cheaper (see lib/contact-shadow.ts).

      // THE RIG IS INVERTED FOR THE DARK GROUND.
      //
      // Against paper, ambient did almost all the work and the directionals
      // existed only to keep the form from flattening. Against the void that
      // is exactly wrong: a bright ambient lifts the product off the ground
      // colour and it reads as a sticker. Here the room is UNLIT and the
      // product is only what the sources find, which is what makes the light
      // itself the subject.
      //
      // Warm key, cool rim — the same warm-core/cool-falloff rule the CSS
      // --color-glow tokens follow, so the object and the page agree about
      // what light is made of.

      // Barely there. Enough that the shadow side is dark rather than absent;
      // a true zero would clip whole faces to the background and the
      // silhouette would break up.
      const sky = new THREE.HemisphereLight(0xbcd0e8, 0x0a0a0c, 0.42);
      scene.add(sky);

      // Key. Strong, warm, and the only source with authority over form. Its
      // POSITION IS SCROLL-DRIVEN — see scenes/studio.ts, which orbits it as
      // the page moves so that scrolling is what moves the light.
      const key = new THREE.DirectionalLight(0xfff0dc, 3.1);
      key.position.set(-2.2, 4.2, 3.4);
      key.castShadow = false;
      scene.add(key);

      // Fill, deliberately weak. On dark the shadow side is doing real work —
      // it is what gives the object mass — so opening it up too far throws
      // away the whole effect.
      const fill = new THREE.DirectionalLight(0xdfe8f5, 0.22);
      fill.position.set(3.6, 0.4, 2.2);
      fill.castShadow = false;
      scene.add(fill);

      // Rim, from behind and above, and cool. This is the load-bearing light
      // in a dark scene: it draws a bright edge along the product's contour
      // and that edge is the only thing separating a dark object from a dark
      // background. On paper this was a 0.35 hue nudge; here it is nearly as
      // strong as the key.
      const rim = new THREE.DirectionalLight(0x9fb4d0, 2.35);
      rim.position.set(0.8, 2.6, -3.8);
      rim.castShadow = false;
      scene.add(rim);

      // ---- camera -----------------------------------------------------------
      // 32° vertical FOV — roughly a 90mm lens on full-frame. Product
      // photography lives in that range because a wide lens bows straight
      // edges and exaggerates the near face, which on a machined object reads
      // as a modelling error rather than as perspective.
      const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 400);
      camera.position.set(0, 0, 12);

      const resize = () => {
        // clientWidth, not innerWidth. innerWidth includes the classic
        // scrollbar gutter, but the canvas lays out at 100% of the content box
        // without it — so the drawing buffer was ~15px wider than the element
        // and every frame rendered at a ~1% horizontal squash whenever a
        // scrollbar was present, which on this site is always.
        const w = cv.clientWidth || innerWidth || 1;
        const h = cv.clientHeight || innerHeight || 1;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      };
      resize();
      addEventListener('resize', resize, { passive: true });

      // Pointer in normalised device coords, damped by whoever consumes it.
      const pointer = new THREE.Vector2(0, 0);
      addEventListener(
        'pointermove',
        (e) => {
          pointer.x = (e.clientX / innerWidth) * 2 - 1;
          pointer.y = -((e.clientY / innerHeight) * 2 - 1);
        },
        { passive: true },
      );

      // ---- GLB loader -------------------------------------------------------
      // MESHOPT ONLY. DRACOLoader used to be wired here alongside it, on the
      // reasoning that the original Blender exports ship
      // KHR_draco_mesh_compression. They do — but the site does not load them.
      // Read straight out of the GLB JSON chunks, both assets this page
      // actually requests declare:
      //
      //   extensionsRequired: ["EXT_meshopt_compression", "KHR_mesh_quantization"]
      //
      // and neither mentions Draco. The decoder was 702 KB of the production
      // bundle — the single largest chunk after three itself — supporting a
      // format nothing asks for. If a Draco asset is ever added back, this is
      // where the loader goes, and the asset will fail loudly at load with
      // "decoder must be called before loading compressed files" rather than
      // degrading silently.
      let gltfLoader: any = null;
      const loadGLB = async (url: string) => {
        if (!gltfLoader) {
          const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
          const { MeshoptDecoder } = await import(
            'three/examples/jsm/libs/meshopt_decoder.module.js'
          );
          gltfLoader = new GLTFLoader();
          gltfLoader.setMeshoptDecoder(MeshoptDecoder);
        }
        const gltf: any = await gltfLoader.loadAsync(url);
        let meshes = 0;
        let triangles = 0;
        gltf.scene.traverse((c: any) => {
          if (!c.isMesh) return;
          meshes++;
          const g = c.geometry;
          triangles += (g.index ? g.index.count : g.attributes.position.count) / 3;
        });
        return { gltf, root: gltf.scene, meshes, triangles: Math.round(triangles) };
      };

      // ---- the tick ---------------------------------------------------------
      // Subscribers run before the draw, in registration order. Returning the
      // unsubscribe keeps scene swaps from leaking callbacks.
      type Tick = (t: number, dt: number) => void;
      const tickFns = new Set<Tick>();
      const onTick = (fn: Tick) => {
        tickFns.add(fn);
        return () => tickFns.delete(fn);
      };

      let renderOverride: ((t: number, dt: number) => void) | null = null;
      const setRenderOverride = (fn: (t: number, dt: number) => void) => {
        renderOverride = fn;
        return () => { renderOverride = null; };
      };

      onFrame((t, dt) => {
        resize();
        for (const fn of tickFns) fn(t, dt);
        if (renderOverride) renderOverride(t, dt);
        else renderer.render(scene, camera);
      });

      (window as any).__scene = {
        THREE,
        scene,
        camera,
        renderer,
        pointer,
        lights: { sky, key, fill, rim },
        view,        // shared scroll progress, written once per frame
        loadGLB,
        onTick,
        setRenderOverride,
        clockTicks,  // frames driven since load; 0 after a second means a dead clock
        ready: true,
      };

      cv.setAttribute('data-ready', '');
      document.dispatchEvent(new CustomEvent('stage:ready'));
    })();
  }
</script>
