---
// THE UNBROKEN SCROLL THREAD.
//
// One fixed canvas behind the entire document, never unmounted, never
// restarted. Rather than chaining separate background effects (which is
// where seams come from), a single shader continuously morphs through four
// movements as scroll progress advances:
//
//   0.00  drift    slow domain-warped liquid, near-still
//   0.33  current  the warp gains direction and speed
//   0.66  nebula   the field opens, chroma rises, structure loosens
//   1.00  settle   it closes back down toward stillness
//
// Because the movements are positions on one continuous parameter rather
// than discrete animations, there is nothing to hand off and nothing to
// break. The previous build's hard tonal seam came from an OPAQUE canvas in
// a bleeding section; this one is alpha and fixed, so sections float over it.
---

<!-- transition:persist is what makes the "never unmounted, never restarted"
     contract above actually true. Without it the ClientRouter swaps in a fresh
     canvas on every navigation, the initialised one is detached (still being
     driven by the shared clock, rendering into nothing) and the new one never
     receives data-ready — so the thread goes invisible the moment a visitor
     clicks a project. -->
<canvas class="field" data-field transition:persist="field" aria-hidden="true"></canvas>

<style>
  .field {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: var(--z-field);
    display: block;
    pointer-events: none;
    opacity: 0;
    transition: opacity 2600ms var(--ease);
  }
  .field[data-ready] { opacity: var(--field-a); }
</style>

<script>
  import { onFrame, view, damp } from '../lib/loop';

  const cv = document.querySelector<HTMLCanvasElement>('[data-field]');
  if (cv) {
    const gl = cv.getContext('webgl2', { antialias: false, alpha: true, premultipliedAlpha: false, powerPreference: 'low-power' });
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (gl) {
      const VERT = `#version 300 es
      in vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }`;

      const FRAG = `#version 300 es
      precision highp float;
      out vec4 o;
      uniform vec2 uRes;
      uniform float uT;
      uniform vec2 uM;
      uniform float uP;      // scroll progress 0..1 — drives the movements
      uniform vec3 uAccent;
      uniform float uLight;  // 1 = light theme

      float h(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453); }
      float n(vec2 p){
        vec2 i = floor(p), f = fract(p);
        vec2 u = f*f*(3.0-2.0*f);
        return mix(mix(h(i), h(i+vec2(1,0)), u.x), mix(h(i+vec2(0,1)), h(i+vec2(1,1)), u.x), u.y);
      }
      float fbm(vec2 p){
        float v = 0.0, a = 0.5;
        for (int k = 0; k < 5; k++){ v += a*n(p); p *= 2.03; a *= 0.5; }
        return v;
      }

      void main(){
        vec2 uv = (gl_FragCoord.xy - 0.5*uRes) / min(uRes.x, uRes.y);

        // The four movements, as smooth weights over one parameter. They
        // overlap deliberately: at any progress at least two are non-zero,
        // so there is never a moment of handover.
        float wDrift   = 1.0 - smoothstep(0.0,  0.42, uP);
        float wCurrent = smoothstep(0.08, 0.42, uP) * (1.0 - smoothstep(0.42, 0.75, uP));
        float wNebula  = smoothstep(0.38, 0.72, uP) * (1.0 - smoothstep(0.80, 1.0, uP));
        float wSettle  = smoothstep(0.78, 1.0,  uP);

        float speed = 0.030 + wCurrent*0.055 + wNebula*0.040 - wSettle*0.020;
        float t = uT * speed;

        float warp  = 1.1 + wCurrent*0.7 + wNebula*1.5;
        float scale = 1.3 + wNebula*0.85 - wSettle*0.35;

        vec2 m = uM / min(uRes.x, uRes.y);
        float pull = 0.15 / (0.15 + dot(uv-m, uv-m)*3.0);

        // Domain warping — fbm feeding fbm. This is what reads as liquid
        // rather than as moving noise.
        vec2 q = vec2(fbm(uv*1.5 + t), fbm(uv*1.5 + vec2(4.2,1.3) - t));
        vec2 r = vec2(fbm(uv*1.8 + q*warp + t*1.3), fbm(uv*1.8 + q*warp + vec2(2.7,9.2) - t*1.05));
        float f = fbm(uv*scale + r*(1.1 + pull*0.8));

        // Chroma is held right down; the accent only ever arrives at the very
        // top of the range, so the field stays a whisper behind the type.
        float chroma = 0.16 + wNebula*0.30 + wCurrent*0.08;
        vec3 lo = mix(vec3(0.024,0.039,0.071), vec3(0.87,0.88,0.91), uLight);
        vec3 hi = mix(vec3(0.145,0.216,0.400), vec3(0.66,0.69,0.75), uLight);

        vec3 c = mix(lo, hi, smoothstep(0.30, 0.92, f) * (0.55 + wNebula*0.45));
        c = mix(c, uAccent, smoothstep(0.80, 1.0, f + r.x*0.15) * chroma * 0.55);

        float vig = 1.0 - smoothstep(0.40, 1.30, length(uv));
        c *= 0.58 + 0.42*vig;

        // Alpha, not opaque: sections bleed over this instead of butting
        // against it, which is what kills tonal seams.
        float a = (0.55 + 0.45*vig) * mix(1.0, 0.75, uLight);

        c += (h(gl_FragCoord.xy + uT) - 0.5) * 0.006;
        o = vec4(c, a);
      }`;

      const mk = (ty: number, src: string) => {
        const s = gl.createShader(ty)!;
        gl.shaderSource(s, src); gl.compileShader(s);
        if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { console.error('[Field]', gl.getShaderInfoLog(s)); return null; }
        return s;
      };
      const vs = mk(gl.VERTEX_SHADER, VERT), fs = mk(gl.FRAGMENT_SHADER, FRAG);

      if (vs && fs) {
        const pr = gl.createProgram()!;
        gl.attachShader(pr, vs); gl.attachShader(pr, fs); gl.linkProgram(pr);
        if (!gl.getProgramParameter(pr, gl.LINK_STATUS)) {
          console.error('[Field]', gl.getProgramInfoLog(pr));
        } else {
          gl.useProgram(pr);
          gl.enable(gl.BLEND);
          gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

          const b = gl.createBuffer();
          gl.bindBuffer(gl.ARRAY_BUFFER, b);
          gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
          const al = gl.getAttribLocation(pr, 'p');
          gl.enableVertexAttribArray(al);
          gl.vertexAttribPointer(al, 2, gl.FLOAT, false, 0, 0);

          const U = (n: string) => gl.getUniformLocation(pr, n);
          const uRes = U('uRes'), uT = U('uT'), uM = U('uM'), uP = U('uP'),
                uAccent = U('uAccent'), uLight = U('uLight');

          const hex2rgb = (h: string) => {
            const v = h.trim().replace('#', '');
            const s = v.length === 3 ? v.split('').map((c) => c + c).join('') : v;
            const i = parseInt(s, 16);
            return [((i >> 16) & 255) / 255, ((i >> 8) & 255) / 255, (i & 255) / 255] as const;
          };

          const syncTheme = () => {
            const cs = getComputedStyle(document.documentElement);
            const [r, g, bl] = hex2rgb(cs.getPropertyValue('--pa-raw') || '#FF5E00');
            gl.uniform3f(uAccent, r, g, bl);
            gl.uniform1f(uLight, document.documentElement.dataset.theme === 'light' ? 1 : 0);
          };
          syncTheme();
          document.addEventListener('themechange', syncTheme);
          document.addEventListener('projectaccent', syncTheme);

          // Half-res backing store. This is a soft, low-frequency field —
          // the difference is invisible and it costs a quarter of the fragments.
          const resize = () => {
            const d = Math.min(devicePixelRatio, 2) * 0.5;
            const w = Math.max(1, Math.round(cv.clientWidth * d));
            const hh = Math.max(1, Math.round(cv.clientHeight * d));
            if (cv.width !== w || cv.height !== hh) {
              cv.width = w; cv.height = hh;
              gl.viewport(0, 0, w, hh);
              gl.uniform2f(uRes, w, hh);
            }
          };
          resize();
          addEventListener('resize', resize, { passive: true });

          let tx = 0, ty = 0, mx = 0, my = 0, p = 0;
          if (!reduced) {
            addEventListener('pointermove', (e) => {
              const d = Math.min(devicePixelRatio, 2) * 0.5;
              tx = e.clientX * d - cv.width * 0.5;
              ty = (innerHeight - e.clientY) * d - cv.height * 0.5;
            }, { passive: true });
          }

          onFrame((t, dt) => {
            resize();
            mx = damp(mx, tx, 4.0, dt);
            my = damp(my, ty, 4.0, dt);
            p = damp(p, view.progress, 3.0, dt);
            gl.uniform2f(uM, mx, my);
            gl.uniform1f(uP, p);
            gl.uniform1f(uT, reduced ? 14.0 : t);
            gl.drawArrays(gl.TRIANGLES, 0, 3);
          });

          cv.setAttribute('data-ready', '');
        }
      }
    }
  }
</script>
