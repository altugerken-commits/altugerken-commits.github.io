---
// Minimal shell. Head, one font, the clock, the stage. Nothing else.
//
// Gone with the gallery: the theme toggle and its pre-paint script (there is no
// light polarity any more), the full-page mask transition, the nav, the cursor
// and the JSON-LD/OG block's dependence on the old brand card. SEO basics stay
// because they are infrastructure, not aesthetic.
//
// The display serif is deliberately NOT loaded. Instrument Serif was the voice
// of the editorial direction that just got purged, and the reference sites run
// bold sans plus mono. Type is an open decision — say the word and I will wire
// whichever face you want through astro.config's Fonts API.
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Scene from '../components/Scene.astro';

interface Props { title?: string; description?: string; }

const {
  title = 'Altug Erken — Industrial Designer',
  description =
    'Altug Erken (Altuğ Erken) is an industrial designer who turns complex engineering problems into aesthetic, manufacturable objects.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://altugerken.com');
const ogImage = new URL('/og.png', canonical);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-mono" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage.href} />

    <ClientRouter />
  </head>

  <body>
    <a class="sr-only" href="#main">Skip to content</a>

    <Scene />

    <main id="main" class="layer">
      <slot />
    </main>

    <script>
      import gsap from 'gsap';
      import 'gsap/ScrollTrigger';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';
      import { runFrame, measureScroll } from '../lib/loop';
      import { stepWarp } from '../lib/warp';
      import { stepDetail } from '../lib/detail';

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ONE clock. Lenis -> gsap.ticker -> ScrollTrigger -> every registered
      // frame callback. Nothing else may own a rAF. Kept from the previous
      // build because it is engine, and because spatial scrolling makes a
      // single authoritative scroll value more important, not less.
      gsap.registerPlugin(ScrollTrigger);

      let lenis: any = null;
      if (!reduced) {
        lenis = new Lenis({ lerp: 0.075, wheelMultiplier: 0.85 });
        lenis.on('scroll', ScrollTrigger.update);
      }
      // Exposed so the warp navigation can drive a programmatic scroll through
      // the SAME smoothing the wheel uses. Animating window.scrollTo instead
      // would fight Lenis for control of scrollY and stutter.
      (window as any).__lenis = lenis;

      // gsap hands the ticker (time, deltaTime, ...) with deltaTime in ms.
      // measureScroll needs it to differentiate scrollY into a velocity, and to
      // run the asymmetric energy envelope frame-rate independently.
      gsap.ticker.add((t, dtMs) => {
        if (lenis) lenis.raf(t * 1000);
        measureScroll(Math.min(dtMs, 100) / 1000);
        // Advanced before the frame callbacks so every scene reads the same
        // warp value within a frame.
        stepWarp(performance.now());
        stepDetail(performance.now());
        runFrame(t);
      });
      gsap.ticker.lagSmoothing(0);

      document.addEventListener('astro:after-swap', () => {
        window.scrollTo(0, 0);
        ScrollTrigger.refresh();
      });
    </script>
  </body>
</html>
