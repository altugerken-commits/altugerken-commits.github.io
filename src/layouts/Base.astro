---
// The shell. Head, two faces, the grain, the clock, the stage.
//
// Kept from the previous build because they are engine, not aesthetic:
//   - ONE clock. Lenis -> gsap.ticker -> ScrollTrigger -> every registered
//     frame callback. Nothing else may own a rAF. Five competing loops is how
//     a continuous scroll turns into parts that visibly disagree.
//   - transition:persist on the canvas. Component <script> modules do not
//     re-execute after a ClientRouter swap, so without it the initialised
//     WebGL context is replaced by a blank canvas on the first navigation.
//
// Gone with the cosmic direction: the warp navigation (a light-speed streak
// belongs to a starfield, not to a studio — internal jumps are now a smoothed
// Lenis scroll) and the dark polarity.
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Scene from '../components/Scene.astro';

interface Props { title?: string; description?: string; }

const {
  title = 'Altuğ Erken — Industrial Designer',
  description =
    'Altuğ Erken is an industrial design and engineering student at Özyeğin University, working on modular outdoor equipment and Formula Student composite bodywork.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://altugerken.com');
const ogImage = new URL('/og.png', canonical);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />

    {/* The ground colour, declared to the browser so the chrome around the
        page (and the overscroll gutter) matches the paper instead of flashing
        the default white before CSS lands. */}
    <meta name="theme-color" content="#f4f3f0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    {/* Scroll reveals start from opacity 0, which is only safe if something is
        guaranteed to turn them back on. This runs during head parse, before
        first paint, so the hidden state is only ever authored when JS is
        confirmed present — with JS off or broken the content simply renders.
        A CSS-only hidden state has no such guarantee and fails to a blank page. */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage.href} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <Scene />

    <main id="main" class="layer">
      <slot />
    </main>

    {/* Fixed, pointer-events:none, above the content and below the chrome.
        Large fields of flat paper are where this direction looks sterile;
        the grain is what gives them a surface. */}
    <div class="grain" aria-hidden="true"></div>

    <ClientRouter />

    <script>
      import gsap from 'gsap';
      import 'gsap/ScrollTrigger';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';
      import { runFrame, measureScroll } from '../lib/loop';
      import { stepDetail } from '../lib/detail';

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      gsap.registerPlugin(ScrollTrigger);

      let lenis: any = null;
      if (!reduced) {
        lenis = new Lenis({ lerp: 0.085, wheelMultiplier: 0.9 });
        lenis.on('scroll', ScrollTrigger.update);
      }
      // Exposed so in-page navigation can drive a programmatic scroll through
      // the SAME smoothing the wheel uses. Animating window.scrollTo instead
      // would fight Lenis for control of scrollY and stutter.
      (window as any).__lenis = lenis;

      // gsap hands the ticker (time, deltaTime) with deltaTime in ms.
      // measureScroll needs it to differentiate scrollY into a velocity and to
      // run its envelope frame-rate independently.
      gsap.ticker.add((t, dtMs) => {
        if (lenis) lenis.raf(t * 1000);
        measureScroll(Math.min(dtMs, 100) / 1000);
        // Advanced before the frame callbacks so every scene reads the same
        // detail progress within a frame.
        stepDetail(performance.now());
        runFrame(t);
      });
      gsap.ticker.lagSmoothing(0);

      document.addEventListener('astro:after-swap', () => {
        window.scrollTo(0, 0);
        ScrollTrigger.refresh();
      });
    </script>
  </body>
</html>
