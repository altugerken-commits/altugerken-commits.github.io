---
import Base from '../../layouts/Base.astro';
import Stage from '../../components/Stage.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, prev: projects[(i - 1 + projects.length) % projects.length], next: projects[(i + 1) % projects.length] },
  }));
}

const { p, prev, next } = Astro.props;
---

<Base
  title={`${p.title} — Altug Erken`}
  description={`${p.title}. ${p.summary}`}
  accent={p.slug}
>
  <article
    class="pj"
    data-project={p.slug}
    data-accent={p.accent}
    data-model={p.model ?? ''}
    style={`--pd:${p.onDark};--pl:${p.onLight};--praw:${p.accent}`}
  >
    <header class="pj__head">
      <p class="hud">
        <a href="/#work" class="pj__back" data-mag>Work</a><i class="sep">/</i>{p.year}
      </p>
      <h1 class="pj__title serif">{p.title}</h1>
      <p class="pj__sub hud">{p.subtitle}</p>
    </header>

    <section class="pj__stage">
      <Stage />
    </section>

    <section class="pj__body">
      <dl class="pj__spec bracket">
        <div><dt class="hud hud--faint">Material</dt><dd class="hud">{p.material}</dd></div>
        <div><dt class="hud hud--faint">Year</dt><dd class="hud">{p.year}</dd></div>
        <div><dt class="hud hud--faint">Accent</dt><dd class="hud"><span class="pj__chip" aria-hidden="true"></span>{p.accent}</dd></div>
        <div><dt class="hud hud--faint">Model</dt><dd class="hud">{p.model ? 'Loaded' : 'Awaiting upload'}</dd></div>
      </dl>

      <p class="pj__lead serif" data-reveal>{p.summary}</p>
    </section>

    <nav class="pj__nav" aria-label="Project navigation">
      <a class="pj__np" href={`/work/${prev.slug}`} data-tab>
        <span class="hud hud--faint">Previous</span>
        <span class="serif pj__npt">{prev.title}</span>
      </a>
      <a class="pj__np pj__np--r" href={`/work/${next.slug}`} data-tab>
        <span class="hud hud--faint">Next</span>
        <span class="serif pj__npt">{next.title}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .pj {
    position: relative;
    z-index: var(--z-section);
    --pa: var(--pd);
    padding: clamp(7rem, 18vh, 11rem) clamp(1.1rem, 6vw, 7rem) clamp(6rem, 16vh, 10rem);
  }
  :global([data-theme="light"]) .pj { --pa: var(--pl); }

  .pj__head { max-width: 90rem; margin: 0 auto clamp(2.5rem, 8vh, 5rem); }
  .pj__back { color: var(--ink-mute); text-decoration: none; }
  .pj__back:hover { color: var(--pa); }
  .pj__title {
    margin: 1.25rem 0 0.75rem;
    font-size: var(--text-d1);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .pj__sub { color: var(--ink-mute); }

  .pj__stage {
    position: relative;
    max-width: 90rem;
    margin: 0 auto clamp(3rem, 10vh, 6rem);
    height: clamp(22rem, 62vh, 46rem);
  }

  .pj__body {
    max-width: 90rem;
    margin-inline: auto;
    display: grid;
    gap: clamp(2.5rem, 7vw, 5rem);
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
  }
  @media (max-width: 820px) { .pj__body { grid-template-columns: minmax(0, 1fr); } }

  .pj__spec { display: grid; gap: 1.1rem; align-content: start; padding: 1.25rem; }
  .pj__spec div { display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; align-items: baseline; }
  .pj__spec dd { margin: 0; color: var(--ink-dim); display: flex; align-items: center; gap: 0.55em; }
  .pj__chip { width: 7px; height: 7px; border-radius: 50%; background: var(--praw); box-shadow: 0 0 0 1px color-mix(in oklab, var(--ink) 22%, transparent); }

  .pj__lead {
    margin: 0;
    max-width: 40rem;
    font-size: var(--text-d3);
    line-height: 1.55;
    color: var(--ink-mute);
  }
  [data-reveal] { opacity: 0; }

  .pj__nav {
    max-width: 90rem;
    margin: clamp(6rem, 18vh, 11rem) auto 0;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--hair) calc(var(--hair-a) * 100%), transparent);
    padding-top: clamp(1.75rem, 5vh, 3rem);
  }
  .pj__np { display: grid; gap: 0.5rem; text-decoration: none; }
  .pj__np--r { text-align: right; justify-items: end; }
  .pj__npt { font-size: var(--text-d3); color: var(--ink-dim); transition: color 700ms var(--ease); }
  .pj__np:hover .pj__npt { color: var(--pa); }
</style>

<script>
  import gsap from 'gsap';
  // Side-effect import — see the note in index.astro.
  import 'gsap/ScrollTrigger';

  // The accent and the staged model are both applied per page load by Base and
  // Stage respectively — not from here. This module only executes when a
  // project page is the entry point, so anything page-specific done at this
  // scope silently stops happening once the visitor navigates client-side.

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((n) => {
      gsap.fromTo(n, { opacity: 0, y: 34 },
        { opacity: 1, y: 0, duration: 1.6, ease: 'expo.out',
          scrollTrigger: { trigger: n, start: 'top 88%', once: true } });
    });
  }
</script>
