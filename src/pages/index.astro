---
import Base from '../layouts/Base.astro';

// Copy lives here rather than in a content collection: two projects is not a
// collection, it is a page. The moment there is a third with its own route,
// this moves to src/content and the loop below stays identical.
const projects = [
  {
    id: 'nomad',
    title: 'Nomad Brewer',
    lead:
      'A modular outdoor coffee and tea brewer. The body separates into stacked components that travel nested and assemble by feel, without a manual.',
    body: [
      'Each joint is a twist-lock: a quarter turn seats and seals it, so the whole stack can be built and struck with cold hands and one hand free.',
      'Dark matte ceramic for the structure, frosted glass for the vessels — the brew level has to be readable without opening anything.',
    ],
    spec: [
      ['Type', 'Modular outdoor brewing device'],
      ['System', 'Stacked components, twist-lock'],
      ['Materials', 'Matte ceramic, frosted glass'],
      ['Status', 'Concept, 2025'],
    ],
    side: 'left' as const,
  },
  {
    id: 'shifu',
    title: 'Shifu 26',
    lead:
      'Formula Student bodywork for Ozu Racing, developed inside the composites and aerodynamics sub-team.',
    body: [
      'Carbon fibre skins over a steel spaceframe, with enamel detailing held to the minimum the regulations allow.',
      'The model here is the full assembly: 1,498 CAD bodies consolidated by material into carbon, steel and enamel, then decimated for the web without altering a single material definition.',
    ],
    spec: [
      ['Team', 'Ozu Racing'],
      ['Sub-team', 'Composites & aerodynamics'],
      ['Scope', 'Carbon bodywork, steel chassis'],
      ['Assembly', '1,498 bodies, 3 materials'],
    ],
    side: 'right' as const,
  },
];

const toolkit = [
  ['Fusion 360', 'Parametric CAD'],
  ['Rhino 3D', 'Surface modelling'],
  ['SolidWorks', 'Assemblies, drawings'],
  ['Blender', 'Mesh, look development'],
  ['D5 Render', 'Real-time visualisation'],
  ['Creative Cloud', 'Layout, retouch'],
];
---

<Base>
  {/* ---- floating nav ----------------------------------------------------
      A detached pill, not an edge-to-edge bar glued to the top. Three links
      fit on a phone at this size, so there is no hamburger and no full-screen
      modal — a morphing menu for three words would be ceremony, not craft. */}
  <nav class="nav" aria-label="Primary">
    <ul class="nav__list">
      <li><a href="#work" data-navlink="work">Work</a></li>
      <li><a href="#about" data-navlink="about">About</a></li>
      <li><a href="#contact" data-navlink="contact">Contact</a></li>
    </ul>
  </nav>

  {/* ---- hero ------------------------------------------------------------
      Cinematic Center. The name is the whole composition, sitting in an unlit
      volume with two sources behind it and dust drifting through the beam.

      Deliberately absent, per the hero bans: no eyebrow tag, no pill badge,
      no floating stamp, no stats. Anything placed around the name competes
      with it, and the point of this hero is that there is nothing to compete.

      Two lines, never more. The container is the full shell width so the name
      flows horizontally instead of stacking into a wall of wrapped text. */}
  <header class="hero">
    {/* The sources. Absolute rather than fixed, and promoted to their own
        compositor layer, so scrolling translates a finished texture instead
        of repainting a very large gradient every frame. */}
    <div class="lume hero__lume hero__lume--key" aria-hidden="true"></div>
    <div class="lume hero__lume hero__lume--rim" aria-hidden="true"></div>

    <div class="shell hero__inner">
      <h1 class="t-display hero__name rake lit">Altuğ Erken</h1>

      <p class="t-lead hero__lead" data-reveal data-reveal-delay="2">
        Objects built to be understood without instructions.
      </p>

      <div class="hero__actions" data-reveal data-reveal-delay="3">
        <a class="cta" href="#work">
          <span>See the work</span>
          <span class="cta__pip" aria-hidden="true">
            <svg viewBox="0 0 16 16" focusable="false">
              <path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10" />
            </svg>
          </span>
        </a>
        <a class="cta cta--quiet" href="#contact">
          <span>Get in touch</span>
        </a>
      </div>
    </div>

    <p class="t-label hero__cue" aria-hidden="true">
      <span class="hero__cue-rule"></span>Scroll
    </p>
  </header>

  {/* ---- work ------------------------------------------------------------ */}
  <section id="work" class="work" aria-labelledby="work-heading">
    <h2 id="work-heading" class="sr-only">Selected work</h2>

    {
      projects.map((p) => (
        <article class:list={['project', `project--${p.side}`]} aria-labelledby={`${p.id}-title`}>
          <div class="shell project__grid">
            {/* The box the 3D product fills. It is empty on purpose: the
                studio scene reads its bounding rect every frame and places
                the model to match, so the layout is the single authority on
                where the object sits. Given real dimensions here because a
                zero-height anchor parks its product at scale 0. */}
            <div class="product" data-product={p.id} aria-hidden="true"></div>

            {/* No "01 — Product" label. A numbered meta-label above a heading
                is filler that says nothing the heading does not already say,
                and the ordering is already visible from the page. The title
                leads. */}
            <div class="project__body">
              <h3 id={`${p.id}-title`} class="t-h1 project__title lit" data-reveal>
                {p.title}
              </h3>

              <p class="t-lead" data-reveal data-reveal-delay="1">{p.lead}</p>

              <dl class="spec" data-reveal data-reveal-delay="2">
                {p.spec.map(([k, v]) => (
                  <div class="spec__row">
                    <dt class="t-label">{k}</dt>
                    <dd class="t-spec">{v}</dd>
                  </div>
                ))}
              </dl>

              <button class="cta cta--quiet" type="button" data-inspect={p.id} data-reveal data-reveal-delay="3">
                <span>Inspect in 3D</span>
                <span class="cta__pip" aria-hidden="true">
                  <svg viewBox="0 0 16 16" focusable="false">
                    <path d="M8 1.8 14 5.2v5.6L8 14.2 2 10.8V5.2z" />
                    <path d="M8 8.1 14 5.2M8 8.1v6.1M8 8.1 2 5.2" />
                  </svg>
                </span>
              </button>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  {/* ---- about -----------------------------------------------------------
      Asymmetrical Bento. The bio spans two rows against a stack of narrower
      cards, so the grid never resolves into three equal columns — which the
      audit names as the most generic layout there is. */}
  <section id="about" class="band" aria-labelledby="about-heading">
    <div class="shell">
      {/* No "About" eyebrow. The heading is the section, and a label naming
          what the heading already says is the definition of filler. */}
      <h2 id="about-heading" class="t-h1 about__heading lit" data-reveal>
        Stripping away<br />the unnecessary.
      </h2>

      <div class="bento">
        {/* The bio is the scrubbed block: script splits it into words and
            scroll brings them up from dim to lit, so reading and scrolling are
            the same gesture. The markup stays plain prose — the split happens
            after parse, so the text is real text for a screen reader, for
            selection, and with JS off. */}
        <div class="bezel bento__bio spot" data-reveal>
          <div class="bezel__core bento__pad">
            <div class="words" data-words>
              <p class="t-body">
                I am Altuğ Erken, an industrial design and engineering student at
                Özyeğin University. I operate at the intersection of aesthetic
                form and mechanical function, crafting products that are both
                visually striking and meticulously engineered.
              </p>
              <p class="t-body">
                As a member of the composites and aerodynamics sub-team at Ozu
                Racing, I specialize in the structural design and advanced
                manufacturing of vehicle outer shells.
              </p>
              <p class="t-body">
                Whether I am designing modular outdoor equipment or smart living
                concepts, my philosophy is rooted in stripping away the
                unnecessary. I gravitate towards clean geometries, monochrome
                palettes, and &lsquo;dead-front&rsquo; interfaces, focusing on
                revealing the pure essence and raw materiality of a product.
              </p>
            </div>
          </div>
        </div>

        <div class="bezel bento__facts spot" data-reveal data-reveal-delay="1">
          <div class="bezel__core bento__pad">
            <dl class="spec spec--tight">
              <div class="spec__row">
                <dt class="t-label">Study</dt>
                <dd class="t-spec">Industrial Design &amp; Engineering, Özyeğin University</dd>
              </div>
              <div class="spec__row">
                <dt class="t-label">Team</dt>
                <dd class="t-spec">Ozu Racing — composites &amp; aerodynamics</dd>
              </div>
              <div class="spec__row">
                <dt class="t-label">Based</dt>
                <dd class="t-spec">İstanbul, Türkiye</dd>
              </div>
            </dl>
          </div>
        </div>

        {/* Pre-rendered in Remotion — see remotion/DraftingStrip.tsx. This is
            the one asset on the site that is a fixed timeline rather than a
            response to input, which is exactly the case a frame-indexed
            renderer is for. It loops seamlessly: the grid travels exactly one
            tile over the duration and every annotation starts and ends at
            opacity 0, so the last frame is indistinguishable from the first.

            Decorative, so aria-hidden. preload="none" and no autoplay
            attribute: playback is started from script only when the card is on
            screen AND motion is welcome, and paused again when it leaves. An
            autoplaying loop costs battery for the whole visit otherwise. */}
        <div class="bezel bento__process" data-reveal data-reveal-delay="3">
          <div class="bezel__core bento__strip">
            <video
              class="strip"
              data-strip
              poster="/media/drafting-strip.png"
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
              tabindex="-1"
            >
              <source src="/media/drafting-strip.webm" type="video/webm" />
              <source src="/media/drafting-strip.mp4" type="video/mp4" />
            </video>
          </div>
        </div>

        <div class="bezel bento__kit spot" data-reveal data-reveal-delay="2">
          <div class="bezel__core bento__pad">
            <ul class="kit">
              {
                toolkit.map(([name, role]) => (
                  <li class="kit__row">
                    <span class="t-h3 kit__name">{name}</span>
                    <span class="t-spec kit__role">{role}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---- contact ---------------------------------------------------------- */}
  <section id="contact" class="band contact" aria-labelledby="contact-heading">
    <div class="lume contact__lume" aria-hidden="true"></div>
    <div class="shell">
      <h2 id="contact-heading" class="t-display contact__heading lit" data-reveal>
        Let&rsquo;s build<br />something solid.
      </h2>

      <ul class="links" data-reveal data-reveal-delay="2">
        <li>
          <a href="mailto:altug.erken@ozu.edu.tr">
            <span class="t-label links__kind">Email</span>
            <span class="t-h3 links__value">altug.erken@ozu.edu.tr</span>
            <span class="links__pip" aria-hidden="true">
              <svg viewBox="0 0 16 16" focusable="false">
                <path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10" />
              </svg>
            </span>
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/altuğ-erken-7b4277305/"
            rel="me noopener"
            target="_blank"
          >
            <span class="t-label links__kind">LinkedIn</span>
            <span class="t-h3 links__value">altuğ-erken</span>
            <span class="links__pip" aria-hidden="true">
              <svg viewBox="0 0 16 16" focusable="false">
                <path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10" />
              </svg>
            </span>
          </a>
        </li>
        <li>
          <a href="https://www.instagram.com/_altugerken_/?hl=tr" rel="me noopener" target="_blank">
            <span class="t-label links__kind">Instagram</span>
            <span class="t-h3 links__value">_altugerken_</span>
            <span class="links__pip" aria-hidden="true">
              <svg viewBox="0 0 16 16" focusable="false">
                <path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10" />
              </svg>
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <footer class="footer">
    <div class="shell footer__grid">
      <p class="t-label">© 2026 Altuğ Erken</p>
      <p class="t-label">İstanbul</p>
    </div>
  </footer>

  {/* ---- detail overlay ---------------------------------------------------
      Present only once the dolly has landed. pointer-events are re-enabled on
      the panel itself: the whole DOM layer is switched off during inspection
      so OrbitControls can see the canvas, and a child may opt back in when an
      ancestor has opted out. */}
  <div class="detail" data-detail hidden>
    <div class="detail__panel">
      {/* No index line. It read "01 — Nomad Brewer" directly above a heading
          that says "Nomad Brewer", which is the same words twice. */}
      <h2 class="t-h2 detail__title lit" data-detail-title></h2>
      <div class="detail__body" data-detail-body></div>
      <button class="cta cta--quiet detail__back" type="button" data-detail-back>
        <span class="cta__pip cta__pip--lead" aria-hidden="true">
          <svg viewBox="0 0 16 16" focusable="false">
            <path d="M10 3.5 5.5 8l4.5 4.5" />
          </svg>
        </span>
        <span>Back to the page</span>
      </button>
    </div>
    <p class="t-label detail__hint">Drag to rotate · move the mouse to move the light · Esc to exit</p>
  </div>
</Base>

<style>
  /* ---- nav --------------------------------------------------------------
     Floating, detached, translucent. Content scrolls underneath it rather
     than being pushed down by a fixed strip. */
  .nav {
    position: fixed;
    top: clamp(1rem, 2.5vw, 1.75rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--z-chrome);
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    background: color-mix(in oklab, var(--color-surface) 72%, transparent);
    backdrop-filter: blur(16px) saturate(150%);
    border-radius: 999px;
    /* A bright top edge is light catching the material — it does more for the
       sense of a physical surface than a full border would, and it avoids the
       generic 1px grey outline. */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      var(--shadow-2);
  }
  .nav__list a {
    display: block;
    padding: 0.5rem 1.05rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    text-decoration: none;
    transition:
      color var(--dur-menu) var(--ease-out),
      background-color var(--dur-menu) var(--ease-out);
  }
  /* Every hover state on this page is gated. On a touch device :hover latches
     after a tap and stays latched until you tap elsewhere, so an ungated hover
     leaves the nav pill lit and the CTA arrow permanently displaced. */
  @media (hover: hover) and (pointer: fine) {
    .nav__list a:hover {
      color: var(--color-ink);
      background: color-mix(in oklab, var(--color-sunken) 80%, transparent);
    }
  }
  /* Which section you are in. Without this the nav answers "where can I go"
     but never "where am I". */
  .nav__list a[data-active] {
    color: var(--color-void);
    background: var(--color-ink);
  }

  @media (max-width: 480px) {
    .nav__list a { padding: 0.5rem 0.75rem; font-size: 0.62rem; }
  }

  /* ---- hero -------------------------------------------------------------- */
  .hero {
    position: relative;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding-block: clamp(7rem, 18vh, 12rem) clamp(5rem, 12vh, 8rem);
    overflow: hidden;
  }

  /* The two sources. Promoted to their own layer so scrolling the hero
     translates a rendered texture rather than repainting a gradient the size
     of the viewport on every frame. */
  .hero__lume {
    will-change: transform;
    transform: translateZ(0);
  }
  .hero__lume--key {
    top: -22vh;
    left: 50%;
    width: min(120vw, 95rem);
    aspect-ratio: 1;
    margin-left: min(-60vw, -47.5rem);
    opacity: 0.85;
  }
  /* A second, tighter and cooler source low and to one side, so the volume has
     two lights in it rather than one symmetrical wash. */
  .hero__lume--rim {
    bottom: -30vh;
    right: -10vw;
    width: min(70vw, 48rem);
    aspect-ratio: 1;
    opacity: 0.5;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in oklab, var(--color-glow-cool) 16%, transparent) 0%,
      transparent 68%
    );
  }

  .hero__inner {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: clamp(1.5rem, 4vh, 2.75rem);
  }

  /* Full shell width and centred. The name must flow horizontally and land on
     one or two lines — a display heading that wraps to four is the single most
     common way a hero stops looking designed. */
  .hero__name {
    margin: 0;
    width: 100%;
    max-width: 18ch;
  }

  .hero__lead {
    margin: 0;
    max-width: 34ch;
    color: var(--color-ink-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .hero__cue {
    position: absolute;
    bottom: clamp(1.75rem, 5vh, 3rem);
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
  }
  .hero__cue-rule {
    display: block;
    width: clamp(2rem, 5vw, 3.5rem);
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }

  /* ---- project ----------------------------------------------------------- */
  .project {
    min-height: 100dvh;
    display: grid;
    align-items: center;
    padding-block: clamp(5rem, 12vh, 9rem) clamp(6rem, 14vh, 11rem);
  }
  .project__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }
  /* Mirrored, so the two case studies do not read as the same page twice.
     Ordering by grid-column rather than by DOM order keeps the heading before
     the decorative box for a screen reader in both directions. */
  .project--right .product { grid-column: 2; grid-row: 1; }
  .project--right .project__body { grid-column: 1; grid-row: 1; }

  .project__body { display: grid; justify-items: start; gap: clamp(1rem, 2.4vh, 1.5rem); }
  .project__title { margin: 0; }
  .project__copy { display: grid; gap: 0.9em; }
  .project__copy p { margin: 0; }

  /* The empty box the 3D model fills. Its shadow is CSS rather than geometry:
     a real cast shadow needs a floor, and this direction has no floor — the
     product floats on paper. A blurred radial under the object reads as
     ambient occlusion without implying a surface it is standing on. */
  .product {
    position: relative;
    aspect-ratio: 4 / 5;
    min-height: 22rem;
  }
  /* On the void a shadow pool is invisible — black under black. The product is
     seated with LIGHT instead: a soft pool behind it, which reads as the beam
     falling on the volume the object occupies and gives the silhouette
     something to be a silhouette against. */
  .product::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 96%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%) translateZ(0);
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in oklab, var(--color-glow) 13%, transparent) 0%,
      color-mix(in oklab, var(--color-glow-cool) 6%, transparent) 40%,
      transparent 68%
    );
    will-change: transform;
  }

  @media (max-width: 900px) {
    .project__grid { grid-template-columns: minmax(0, 1fr); }
    .project--right .product,
    .project--right .project__body { grid-column: 1; grid-row: auto; }
    .product { aspect-ratio: 1 / 1; min-height: 17rem; }
  }

  /* ---- spec -------------------------------------------------------------- */
  .spec { display: grid; gap: 0; margin: 0.5rem 0 0; width: 100%; max-width: 34rem; }
  .spec__row {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--color-hairline);
    align-items: baseline;
  }
  .spec__row:last-child { border-bottom: 1px solid var(--color-hairline); }
  .spec--tight .spec__row { grid-template-columns: 5rem minmax(0, 1fr); }
  .spec dt { margin: 0; }
  .spec dd { margin: 0; }

  @media (max-width: 560px) {
    .spec__row,
    .spec--tight .spec__row { grid-template-columns: minmax(0, 1fr); gap: 0.2rem; }
  }

  /* ---- cta --------------------------------------------------------------
     Nested island button: a pill, with the arrow inside its own circular well
     flush to the inner padding. The pip translates diagonally on hover while
     the button itself presses down, which is what gives it internal tension
     instead of a flat colour swap. */
  .cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.5rem;
    padding: 0.55rem 0.55rem 0.55rem 1.35rem;
    /* The primary action is the brightest object on the page — a lit surface
       on an unlit ground, which is the direction stated in one component.
       That means DARK text on it. When the palette inverted, background:ink
       plus color:paper became near-white on near-white: contrast ratio 1.00,
       a completely invisible button that no visual check here could catch. */
    background: var(--color-ink);
    color: var(--color-void);
    border: 0;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--shadow-2);
    /* transform only. box-shadow was in here, and animating it repaints the
       button and its shadow region on every frame of the hover — the deeper
       shadow is now a pseudo-element crossfaded on opacity instead, which the
       compositor can do without touching paint. */
    transition: transform var(--dur-press) var(--ease-out);
  }
  /* The lifted shadow, pre-rendered and revealed. */
  .cta::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: var(--shadow-3);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-menu) var(--ease-out);
  }
  /* Feedback on the press itself, not on release. Ungated on purpose —
     :active is the one interaction state touch genuinely has. */
  .cta:active { transform: scale(0.975); }

  .cta--quiet {
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-hairline), var(--shadow-1);
  }
  .cta--quiet::after { box-shadow: inset 0 0 0 1px var(--color-ink-3), var(--shadow-2); }

  @media (hover: hover) and (pointer: fine) {
    .cta:hover::after { opacity: 1; }
  }

  .cta__pip {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 999px;
    /* Tinted with the VOID, not the ink: the pip sits inside a near-white
       button, so a light wash would be invisible against it. */
    background: color-mix(in oklab, var(--color-void) 14%, transparent);
    /* 220ms, not 380. A hover response is a UI interaction and lives under the
       300ms budget; at 380 the arrow visibly lags the cursor arriving. */
    transition: transform var(--dur-menu) var(--ease-out);
  }
  .cta--quiet .cta__pip { background: var(--color-sunken); }
  .cta__pip--lead { order: -1; }
  .cta__pip svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (hover: hover) and (pointer: fine) {
    .cta:hover .cta__pip { transform: translate(2px, -2px); }
    .cta:hover .cta__pip--lead { transform: translate(-2px, 0); }
  }

  /* ---- bento ------------------------------------------------------------- */
  .about__heading { margin: 0 0 clamp(2.5rem, 6vh, 4rem); }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }
  .bento__bio     { grid-column: span 7; grid-row: span 2; }
  .bento__facts   { grid-column: span 5; }
  .bento__kit     { grid-column: span 5; }
  .bento__process { grid-column: span 12; }

  /* Flush — the strip is the card's whole content, so the inner plate carries
     no padding and clips the video to its own radius instead. */
  .bento__strip {
    overflow: hidden;
    line-height: 0;
  }
  .strip {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 1;
    object-fit: cover;
  }

  .bento__pad {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    height: 100%;
    display: grid;
    align-content: start;
    gap: 1.1em;
  }
  .bento__bio .t-body { margin: 0 0 1.1em; max-width: 46ch; }
  .bento__bio .t-body:last-child { margin-bottom: 0; }

  .kit { list-style: none; margin: 0; padding: 0; display: grid; }
  .kit__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--color-hairline);
  }
  .kit__row:first-child { border-top: 0; padding-top: 0; }
  .kit__name { color: var(--color-ink); }
  .kit__role { text-align: right; }

  @media (max-width: 900px) {
    .bento__bio,
    .bento__facts,
    .bento__kit,
    .bento__process { grid-column: span 12; grid-row: auto; }
    /* Taller crop on a phone: at full width the 4:1 strip is only ~85px and
       the annotations become unreadable. */
    .strip { aspect-ratio: 5 / 2; }
  }

  /* ---- contact ----------------------------------------------------------- */
  .contact { position: relative; overflow: hidden; }
  /* The page closes on the same light it opened on. */
  .contact__lume {
    top: 50%;
    left: 50%;
    width: min(110vw, 78rem);
    aspect-ratio: 1;
    transform: translate(-50%, -50%) translateZ(0);
    opacity: 0.55;
    will-change: transform;
  }
  .contact__heading { margin: 0 0 clamp(2.5rem, 6vh, 4rem); position: relative; }
  .links { list-style: none; margin: 0; padding: 0; display: grid; }
  .links a {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(1.1rem, 2.4vh, 1.6rem) 0;
    border-top: 1px solid var(--color-hairline);
    text-decoration: none;
    color: var(--color-ink);
    transition: color var(--dur-menu) var(--ease-out);
  }
  .links li:last-child a { border-bottom: 1px solid var(--color-hairline); }
  .links__value { transition: transform var(--dur-menu) var(--ease-out); }
  .links__pip {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 999px;
    background: var(--color-sunken);
    transition:
      transform var(--dur-menu) var(--ease-out),
      background-color var(--dur-menu) var(--ease-out);
  }
  .links__pip svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) and (pointer: fine) {
    .links a:hover { color: var(--color-oxide); }
    .links a:hover .links__value { transform: translateX(6px); }
    .links a:hover .links__pip {
      transform: translate(2px, -2px);
      background: var(--color-oxide-wash);
    }
  }

  @media (max-width: 640px) {
    .links a { grid-template-columns: minmax(0, 1fr) auto; gap: 0.35rem 1rem; }
    .links__kind { grid-column: 1 / -1; }
  }

  /* ---- footer ------------------------------------------------------------ */
  .footer { padding-block: clamp(2.5rem, 6vh, 4rem) clamp(2.5rem, 6vh, 4rem); }
  .footer__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-hairline);
  }
  .footer__colophon { text-align: right; }
  @media (max-width: 640px) { .footer__colophon { text-align: left; } }

  /* ---- detail overlay ---------------------------------------------------- */
  .detail {
    position: fixed;
    inset: 0;
    display: grid;
    align-content: end;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-panel) var(--ease-out);
    z-index: var(--z-overlay);
  }
  .detail[hidden] { display: none; }
  .detail.is-open { opacity: 1; }

  .detail__panel {
    pointer-events: auto;
    width: min(40ch, 42vw);
    margin: 0 0 clamp(2.5rem, 8vh, 5rem) var(--gutter);
    display: grid;
    justify-items: start;
    gap: clamp(0.7rem, 1.8vh, 1.1rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: color-mix(in oklab, var(--color-surface) 82%, transparent);
    backdrop-filter: blur(20px) saturate(150%);
    border-radius: 1.5rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85), var(--shadow-float);
  }
  .detail__title { margin: 0; }
  .detail__body { display: grid; gap: 0.8em; }
  .detail__body p { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--color-ink-2); }
  .detail__back { margin-top: 0.35rem; }

  .detail__hint {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  @media (max-width: 900px) {
    .detail__panel { width: auto; margin-right: var(--gutter); }
    .detail__hint { display: none; }
  }

  /* ---- scroll reveal -----------------------------------------------------
     Authored only under .js, so with scripting off the content renders
     normally instead of staying at opacity 0 forever. A heavy fade-up with a
     blur resolve, per the direction — elements arrive with mass rather than
     popping. Transform and opacity and filter only; nothing here can trigger
     layout. */
  :global(html.js) [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 28px, 0);
    filter: blur(6px);
    transition:
      opacity var(--dur-reveal) var(--ease-out),
      transform var(--dur-reveal) var(--ease-out),
      filter var(--dur-reveal) var(--ease-out);
  }
  :global(html.js) [data-reveal].is-in {
    opacity: 1;
    transform: none;
    filter: none;
  }
  /* Stagger. Delay is a custom property so the cascade stays declarative and
     the observer does not have to compute per-element timing. */
  :global(html.js) [data-reveal-delay="1"] { transition-delay: 70ms; }
  :global(html.js) [data-reveal-delay="2"] { transition-delay: 140ms; }
  :global(html.js) [data-reveal-delay="3"] { transition-delay: 210ms; }
  :global(html.js) [data-reveal-delay="4"] { transition-delay: 280ms; }
  :global(html.js) [data-reveal-delay="5"] { transition-delay: 350ms; }
</style>

<script>
  import { initStudio } from '../scenes/studio';
  import { initMotes } from '../scenes/motes';
  import { initInspect } from '../scenes/inspect';
  import { onFrame } from '../lib/loop';
  import { detail, enterDetail, exitDetail, onDetailChange } from '../lib/detail';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- scroll reveal ---------------------------------------------------------
  // IntersectionObserver, never a scroll listener: a scroll handler that reads
  // geometry runs on every scroll event and forces a reflow each time, which is
  // the single most reliable way to lose frames on mobile.
  //
  // unobserve after firing — these are entrances, not a state that tracks
  // scroll position, and re-animating on the way back up is the thing that
  // makes a long page feel restless.
  const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (revealables.length) {
    // Once the entrance has played, the attribute is REMOVED, not just marked
    // done. This is load-bearing, not tidiness: the reveal rule declares an
    // 800ms transition on transform, and several revealed elements are buttons
    // that declare their own 140ms transform transition for press feedback.
    // Both rules have the same specificity, so the reveal wins on source order
    // and every press on the hero CTA animated over 800ms — a button that
    // takes most of a second to acknowledge a click.
    //
    // Dropping the attribute after the entrance retires the reveal rule
    // entirely and hands each element back its own timing.
    const retire = (el: HTMLElement) => {
      const cs = getComputedStyle(el);
      const secs = (v: string) =>
        Math.max(...v.split(',').map((s) => parseFloat(s) * (s.includes('ms') ? 1 : 1000)), 0);
      // Wait out the longest of duration + delay, plus a frame of slack.
      const wait = secs(cs.transitionDuration) + secs(cs.transitionDelay) + 120;
      setTimeout(() => {
        el.removeAttribute('data-reveal');
        el.classList.remove('is-in');
      }, wait);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          el.classList.add('is-in');
          io.unobserve(el);
          retire(el);
        }
      },
      // Fire a little before the element reaches the fold so the motion has
      // resolved by the time it is properly in view, rather than starting the
      // moment it appears and being read mid-transition.
      { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
    );
    for (const el of revealables) io.observe(el);
  }

  // ---- the drafting strip ----------------------------------------------------
  // Decode only while it is on screen, and never at all under reduced motion.
  // A looping <video autoplay> keeps a decoder alive for the whole visit even
  // when it is three sections above the fold; under reduced motion the poster
  // frame is the correct presentation, and it is already the element's poster
  // so no fallback markup is needed.
  const strip = document.querySelector<HTMLVideoElement>('[data-strip]');
  if (strip && !reduced) {
    const stripIO = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            // play() rejects if the tab has never been interacted with on some
            // policies. It is muted so autoplay is normally permitted, but the
            // rejection must still be swallowed or it surfaces as an unhandled
            // promise rejection in the console.
            strip.play().catch(() => {});
          } else {
            strip.pause();
          }
        }
      },
      { threshold: 0.15 },
    );
    stripIO.observe(strip);
  }

  // ---- nav: where am I -------------------------------------------------------
  const sections = ['work', 'about', 'contact']
    .map((id) => document.getElementById(id))
    .filter(Boolean) as HTMLElement[];
  const navlinks = new Map<string, HTMLElement>();
  for (const a of document.querySelectorAll<HTMLElement>('[data-navlink]')) {
    navlinks.set(a.dataset.navlink!, a);
  }

  if (sections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const link = navlinks.get(e.target.id);
          if (!link) continue;
          if (e.isIntersecting) {
            for (const l of navlinks.values()) l.removeAttribute('data-active');
            link.setAttribute('data-active', '');
          }
        }
      },
      // A band across the middle of the viewport. Whichever section occupies it
      // is the one you are reading — using the whole viewport would light up
      // two links at once on every boundary.
      { rootMargin: '-45% 0px -45% 0px' },
    );
    for (const s of sections) spy.observe(s);
  }

  // In-page anchors go through Lenis so they use the SAME smoothing as the
  // wheel. Native smooth scrolling would run on its own curve and visibly
  // disagree with every other movement on the page.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
    a.addEventListener('click', (e) => {
      const id = a.getAttribute('href')!.slice(1);
      const target = document.getElementById(id);
      const lenis = (window as any).__lenis;
      if (!target || !lenis) return;
      e.preventDefault();
      lenis.scrollTo(target, { offset: 0, duration: reduced ? 0 : 1.1 });
      history.replaceState(null, '', `#${id}`);
    });
  }

  // ---- scrubbed word reveal --------------------------------------------------
  // The bio is brought up word by word as the block crosses the viewport, so
  // reading and scrolling become the same gesture.
  //
  // Purpose: state indication — it makes scroll position legible as reading
  // position. It earns its length because this is a marketing surface, not UI;
  // the sub-300ms budget governs things the user is waiting on, and nothing is
  // waiting here.
  //
  // Written directly to style.opacity per word rather than through a class or a
  // parent CSS variable. Driving a child's value from a variable on the parent
  // restyles every child on every frame, which with ~90 words is a recalc storm.
  const wordHost = document.querySelector<HTMLElement>('[data-words]');
  let wordSpans: HTMLElement[] = [];
  if (wordHost && !reduced) {
    for (const p of Array.from(wordHost.querySelectorAll('p'))) {
      const words = (p.textContent ?? '').split(/\s+/).filter(Boolean);
      p.replaceChildren(
        ...words.flatMap((w, i) => {
          const s = document.createElement('span');
          s.textContent = w;
          // A real space between spans, so the text still selects and reads as
          // a sentence rather than asrunontext.
          return i < words.length - 1 ? [s, document.createTextNode(' ')] : [s];
        }),
      );
    }
    wordSpans = Array.from(wordHost.querySelectorAll('span'));
  }

  // ---- cursor spotlight ------------------------------------------------------
  // Cards light up under the pointer. Hover-gated at the CSS layer; the
  // listener is attached only on a fine pointer so touch devices never pay for
  // the work at all.
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    for (const card of document.querySelectorAll<HTMLElement>('.spot')) {
      card.addEventListener(
        'pointermove',
        (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
          card.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
        },
        { passive: true },
      );
    }
  }

  // ---- detail mode -----------------------------------------------------------
  const COPY: Record<string, { title: string; body: string[] }> = {
    nomad: {
      title: 'Nomad Brewer',
      body: [
        'The body separates into stacked components that travel nested and assemble by feel. Each joint is a twist-lock — a quarter turn seats and seals it.',
        'Dark matte ceramic for the structure, frosted glass for the vessels, so the brew level stays readable without opening anything.',
      ],
    },
    shifu: {
      title: 'Shifu 26',
      body: [
        'Formula Student bodywork for Ozu Racing: carbon fibre skins over a steel spaceframe, developed in the composites and aerodynamics sub-team.',
        '1,498 CAD bodies consolidated by material into carbon, steel and enamel, then decimated for the web without altering a single material definition.',
      ],
    },
  };

  const detailEl = document.querySelector<HTMLElement>('[data-detail]');
  const detailTitle = document.querySelector<HTMLElement>('[data-detail-title]');
  const detailBody = document.querySelector<HTMLElement>('[data-detail-body]');

  const fillDetail = (id: string) => {
    const c = COPY[id];
    if (!c || !detailTitle || !detailBody) return;
    detailTitle.textContent = c.title;
    detailBody.replaceChildren(
      ...c.body.map((t) => {
        const p = document.createElement('p');
        p.textContent = t;
        return p;
      }),
    );
  };

  onDetailChange((s) => {
    if (!detailEl) return;
    if (s.mode === 'active') {
      detailEl.hidden = false;
      // Force a reflow so the browser registers the un-hidden state before the
      // class flips, which is what makes the opacity transition actually run.
      // This was a requestAnimationFrame callback once: rAF does not fire in a
      // throttled or hidden tab, so the overlay could be revealed with its
      // opacity permanently stuck at 0. A synchronous reflow has no such
      // dependency.
      void detailEl.offsetHeight;
      detailEl.classList.add('is-open');
    } else {
      detailEl.classList.remove('is-open');
      if (s.mode === 'idle') {
        setTimeout(() => {
          if (detail.mode === 'idle') detailEl.hidden = true;
        }, 420);
      }
    }
  });

  for (const btn of document.querySelectorAll<HTMLElement>('[data-inspect]')) {
    btn.addEventListener('click', () => {
      const id = btn.dataset.inspect;
      if (!id) return;
      fillDetail(id);
      enterDetail(id);
    });
  }

  document.querySelector('[data-detail-back]')?.addEventListener('click', () => exitDetail());
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && detail.mode === 'active') exitDetail();
  });

  // ---- boot ------------------------------------------------------------------
  const boot = async () => {
    const api = (window as any).__scene;
    if (!api || (window as any).__studio) return;

    try {
      const studio = await initStudio(api);
      (window as any).__studio = studio;

      // Dust in the beam. Started before inspect so it is already drifting by
      // the time anything else can take the camera.
      const motes = initMotes(api);
      (window as any).__motes = motes;

      const inspect = await initInspect(api, studio);
      (window as any).__inspect = inspect;

      // Everything belonging to the scrolling page steps aside while a product
      // is being inspected. Driven from the frame loop rather than from a
      // `html.is-detail` CSS rule: an earlier build used
      // `:global(html.is-detail) .hero` and Astro's scoped-style compilation
      // did not match it, leaving measured opacity at 1 with the class
      // correctly set.
      const pageChrome = [
        document.querySelector<HTMLElement>('.hero'),
        document.querySelector<HTMLElement>('.work'),
        document.querySelector<HTMLElement>('#about'),
        document.querySelector<HTMLElement>('#contact'),
        document.querySelector<HTMLElement>('.footer'),
        document.querySelector<HTMLElement>('.nav'),
      ].filter(Boolean) as HTMLElement[];

      // The DOM layer sits at z-index 1 directly over the canvas and is as tall
      // as the document, so it swallows every pointer event before
      // OrbitControls can see one. Dimming its children is not enough — the
      // container itself still hit-tests.
      const domLayer = document.querySelector<HTMLElement>('main.layer');

      onFrame(() => {
        // 1 on the page, 0 once inspection has fully opened. Squared so the
        // page is out of the way early rather than lingering under the dolly.
        const fade = Math.pow(1 - detail.progress, 2);
        for (const el of pageChrome) {
          el.style.opacity = String(fade);
          el.style.pointerEvents = fade < 0.05 ? 'none' : '';
        }
        if (domLayer) {
          domLayer.style.pointerEvents = detail.progress > 0.02 ? 'none' : '';
        }

        // ---- the words --------------------------------------------------
        // Driven from the frame loop rather than from a scroll listener: the
        // clock already runs once per frame and has the scroll measured, so
        // this costs one rect read instead of a listener that forces a reflow
        // on every scroll event.
        if (wordSpans.length && wordHost) {
          const r = wordHost.getBoundingClientRect();
          const vh = window.innerHeight || 1;
          // 0 as the block's top reaches three-quarters down the viewport, 1
          // once its bottom has climbed near the top — so the text finishes
          // lighting well before it leaves rather than at the last pixel.
          const start = vh * 0.78;
          const end = -r.height + vh * 0.32;
          const k = Math.max(0, Math.min(1, (start - r.top) / Math.max(1, start - end)));

          const n = wordSpans.length;
          // The front runs from before the first word to past the last, so
          // both ends fully resolve. A soft trailing edge over ~8 words keeps
          // it reading as light arriving rather than as a hard wipe.
          const head = k * (n + 12) - 6;
          for (let i = 0; i < n; i++) {
            const o = Math.max(0.18, Math.min(1, 0.18 + (head - i) / 8));
            wordSpans[i].style.opacity = o.toFixed(3);
          }
        }
      });
    } catch (err) {
      console.error('[studio]', err);
    }
  };

  document.addEventListener('stage:ready', boot);
  if ((window as any).__scene?.ready) boot();
</script>
