---
import Base from '../layouts/Base.astro';
---

<Base>
  {/* The dolly reads window scroll through lib/loop's `view.progress`, so the
      document needs actual height to travel across. Three viewports gives the
      camera a slow, deliberate pass down the bodywork. */}
  <div class="scroll-track" aria-hidden="true"></div>

  {/* SCAFFOLDING — comes out with the typographic mask. */}
  <section class="probe">
    <p class="hud" data-probe-status>stage · initialising</p>
    <p class="hud probe--dim" data-probe-model></p>
  </section>
</Base>

<style>
  .scroll-track { height: 300vh; }

  .probe {
    position: fixed;
    left: clamp(1rem, 3vw, 2.5rem);
    bottom: clamp(1rem, 3vw, 2.5rem);
    display: grid;
    gap: 0.4rem;
    pointer-events: none;
    color: color-mix(in oklab, var(--fg) 60%, transparent);
  }
  .probe--dim { color: color-mix(in oklab, var(--fg) 32%, transparent); }
</style>

<script>
  import { initShifuShell } from '../scenes/shifu-shell';

  const MODEL = '/models/shifu-26-bodywork.glb';
  const status = document.querySelector<HTMLElement>('[data-probe-status]');
  const detail = document.querySelector<HTMLElement>('[data-probe-model]');

  const boot = async () => {
    const api = (window as any).__scene;
    if (!api || (window as any).__shifuScene) return;
    if (status) status.textContent = 'stage · loading shell';
    try {
      const info = await initShifuShell(api, MODEL);
      if (status) status.textContent = 'shifu 26 · bodywork';
      if (detail) {
        detail.textContent = `${info.triangles.toLocaleString()} tris · ${info.pointCount.toLocaleString()} carbon points · steel + enamel solid`;
      }
    } catch (err) {
      if (status) status.textContent = 'stage · load failed';
      if (detail) detail.textContent = String((err as Error)?.message ?? err);
      console.error('[shifu]', err);
    }
  };

  document.addEventListener('stage:ready', boot);
  if ((window as any).__scene?.ready) boot();
</script>
