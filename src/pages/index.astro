---
import Base from '../layouts/Base.astro';
---

<Base>
  {/* SCAFFOLDING — delete on first real scene.
      A blank stage over a black ground is indistinguishable from a broken
      build, so this readout exists purely to prove the engine is alive. It
      reports what the stage actually initialised, and nothing about it is a
      design proposal. */}
  <section class="boot">
    <p class="boot__line" data-boot-status>stage · initialising</p>
    <p class="boot__line boot__line--dim" data-boot-detail></p>
  </section>
</Base>

<style>
  .boot {
    position: fixed;
    left: clamp(1rem, 3vw, 2.5rem);
    bottom: clamp(1rem, 3vw, 2.5rem);
    display: grid;
    gap: 0.35rem;
    pointer-events: none;
  }
  .boot__line {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--fg) 55%, transparent);
  }
  .boot__line--dim { color: color-mix(in oklab, var(--fg) 30%, transparent); }
</style>

<script>
  const status = document.querySelector<HTMLElement>('[data-boot-status]');
  const detail = document.querySelector<HTMLElement>('[data-boot-detail]');

  const report = () => {
    const s = (window as any).__scene;
    if (!s || !status || !detail) return;
    const r = s.renderer;
    const gl = r.getContext();
    status.textContent = 'stage · ready';
    detail.textContent = [
      `webgl${gl instanceof WebGL2RenderingContext ? '2' : '1'}`,
      `${r.domElement.width}×${r.domElement.height}`,
      `dpr ${r.getPixelRatio()}`,
      `${s.scene.children.length} objects`,
    ].join('  ·  ');
  };

  document.addEventListener('stage:ready', report);
  if ((window as any).__scene?.ready) report();
</script>
