---
import Base from '../layouts/Base.astro';
import { TRACK_VH } from '../lib/stops';
---

<Base>
  {/* Greeting first, then About/Contact, then the empty track that gives the
      camera something to travel across.

      The track USED to come first. That was invisible while the hero was
      position:fixed, but the moment the hero moved into normal flow the track's
      1000vh of empty div sat in front of it and pushed the greeting and the
      About copy to the very bottom of the document. Content leads; the spacer
      follows and is sized to whatever is left. */}
  <section class="hero">
    <h1 class="hero__title display" data-greeting>Good Evening.</h1>
  </section>

  {/* About and Toolkit are columns of ONE section, with a gutter down the
      middle for the beam. Sharing a section is what guarantees they align
      horizontally and share a scroll lifecycle exactly — two independently
      positioned blocks would have to be kept in agreement by hand. */}
  <section class="about">
    <div class="about__col">
    <p class="hud about__label">About</p>
    <div class="about__body display">
      <p>
        I am an industrial design and engineering student at Özyeğin University,
        working where the drawing has to survive contact with a manufacturing
        process.
      </p>
      <p>
        My work sits between form and structure — brewing equipment, composite
        bodywork, things that are held and things that are driven. I care about
        the decisions that do not show: wall thickness, draft, the tolerance
        that makes an assembly feel deliberate instead of merely tight.
      </p>
    </div>

    <div class="about__contact">
      <p class="hud about__label">Contact</p>
      <ul class="about__links hud">
        <li><a href="mailto:altug.erken@ozu.edu.tr">altug.erken@ozu.edu.tr</a></li>
        <li><a href="https://www.linkedin.com/" rel="me noopener" target="_blank">LinkedIn</a></li>
        <li><a href="https://github.com/altugerken-commits" rel="me noopener" target="_blank">GitHub</a></li>
      </ul>
      <p class="about__cue display">Keep scrolling.</p>
    </div>
    </div>

    <div class="toolkit">
      <p class="hud about__label">Digital Toolkit</p>
      <ul class="toolkit__list display">
        <li>Fusion 360</li>
        <li>Rhino 3D</li>
        <li>Adobe Creative Cloud</li>
        <li>D5 Render</li>
        <li>Blender</li>
        <li>SolidWorks</li>
      </ul>
    </div>
  </section>

  {/* Empty travel for the camera. Sized to the remainder of the track so the
      total document height still equals TRACK_VH regardless of how tall the
      content above grows. */}
  <div
    class="scroll-track"
    style={`height:calc(${TRACK_VH * 100}vh - 200vh)`}
    aria-hidden="true"
  ></div>

  {/* FIXED NAV. Top-right, above everything including the white-out card. */}
  <nav class="nav" aria-label="Primary">
    <button class="nav__btn" type="button" data-warp-home aria-label="Home">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3.6 10.6 12 3.8l8.4 6.8" />
        <path d="M5.8 9.4V20h12.4V9.4" />
      </svg>
      <span class="nav__label">Home</span>
    </button>
    <button
      class="nav__btn"
      type="button"
      data-warp-search
      aria-label="Search stops"
      aria-expanded="false"
      aria-controls="warp-menu"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="10.8" cy="10.8" r="6.4" />
        <path d="m15.6 15.6 4.2 4.2" />
      </svg>
      <span class="nav__label">Search</span>
    </button>

    <ul class="nav__menu" id="warp-menu" data-warp-menu hidden>
      <li><button type="button" data-warp-to="0">Top</button></li>
      <li><button type="button" data-warp-to="1">About &amp; Contact</button></li>
      <li><button type="button" data-warp-to="5">01 — Nomad Brewer</button></li>
      <li><button type="button" data-warp-to="7.4">02 — Shifu 26</button></li>
    </ul>
  </nav>

  {/* DETAIL MODE OVERLAY. Present only at the far end of the portal. */}
  <div class="detail" data-detail hidden>
    <div class="detail__panel">
      <p class="hud detail__index" data-detail-index></p>
      <h2 class="detail__title display" data-detail-title></h2>
      <div class="detail__body" data-detail-body></div>
      <button class="detail__back hud" type="button" data-detail-back>
        <span aria-hidden="true">←</span>
        <span>Back</span>
      </button>
    </div>
    <p class="hud detail__hint">Drag to rotate · scroll to zoom</p>
  </div>

  {/* Pinned to the bottom of the viewport, cleared the moment scrolling starts. */}
  <p class="hero__sub" data-hero-sub>Scroll down to navigate in my design galaxy.</p>

  {/* THE THRESHOLD CARD. Lives only inside the pure-white plateau. Pure black
      on #FFFFFF, which is the one moment on this site that inverts. */}
  <div class="threshold" data-threshold aria-hidden="true">
    <p class="threshold__word display">Welcome.</p>
  </div>

  {/* Inline and un-bundled on purpose. The greeting depends on the visitor's
      local clock, which the server cannot know — rendering a guess and
      correcting it later would flash the wrong time of day. This runs during
      parse, immediately after the element exists and before first paint, so
      the only text ever painted is the correct one. The markup ships a bare
      "Welcome" as the no-JS fallback. */}
  <script is:inline>
    window.__setGreeting = function () {
      var el = document.querySelector('[data-greeting]');
      if (!el) return;
      var h = new Date().getHours();
      var part =
        h < 5 ? 'Night' : h < 12 ? 'Morning' : h < 17 ? 'Afternoon' : h < 21 ? 'Evening' : 'Night';
      el.textContent = 'Good ' + part + '.';
    };
    window.__setGreeting();
  </script>

  {/* FIRST STOP — NOMAD BREWER. Sits opposite the object, which holds frame
      centre. Hidden from AT and from tab order until it is present. */}
  <aside class="stop stop--right" data-stop="nomad" aria-hidden="true">
    <p class="hud stop__index">01 — Stop</p>
    <h2 class="stop__title display">Nomad Brewer</h2>
    <dl class="stop__meta hud">
      <div><dt>Type</dt><dd>Modular outdoor coffee &amp; tea brewing device</dd></div>
      <div><dt>System</dt><dd>Stacked components · twist-lock mechanism</dd></div>
      <div><dt>Materials</dt><dd>Dark matte ceramic · frosted glass</dd></div>
    </dl>
    <button class="stop__cta hud" type="button" data-stop-cta="nomad">
      <span>View details</span>
      <span class="stop__rule" aria-hidden="true"></span>
    </button>
  </aside>

  {/* SECOND STOP — SHIFU. Mirrored to the opposite side so the two showcases
      do not read as the same slide twice. */}
  <aside class="stop stop--left" data-stop="shifu" aria-hidden="true">
    <p class="hud stop__index">02 — Stop</p>
    <h2 class="stop__title display">Shifu 26</h2>
    <dl class="stop__meta hud">
      <div><dt>Team</dt><dd>Ozu Racing</dd></div>
      <div><dt>Sub-team</dt><dd>Composites &amp; Aerodynamics</dd></div>
      <div><dt>Scope</dt><dd>Carbon bodywork · steel chassis</dd></div>
    </dl>
    <button class="stop__cta hud" type="button" data-stop-cta="shifu">
      <span>View details</span>
      <span class="stop__rule" aria-hidden="true"></span>
    </button>
  </aside>

  {/* SCAFFOLDING — status probe. */}
  <p class="hud probe" data-probe>stage · initialising</p>
</Base>

<style>
  /* In flow, not fixed: the greeting scrolls up and away with the document. */
  .hero {
    min-height: 100vh;
    display: grid;
    place-content: center;
    justify-items: center;
    padding: 0 clamp(1.25rem, 5vw, 4rem);
  }

  /* The beam is blown out at frame centre, so white type laid straight over it
     loses its counters. A narrow scrim — only as tall as the line itself —
     buys back the contrast without putting a visible plate in the void. */
  .hero__title {
    position: relative;
    margin: 0;
    font-size: clamp(2.25rem, 7vw, 6rem);
    font-weight: 300;
    font-style: italic;
    letter-spacing: 0.01em;
    text-align: center;
    padding: 0.4em clamp(1rem, 6vw, 5rem);
    color: #fff;
    text-shadow:
      0 0 26px rgba(0, 0, 0, 0.85),
      0 0 70px rgba(0, 0, 0, 0.6);
  }
  .hero__title::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.6) 22%,
      rgba(0, 0, 0, 0.72) 50%,
      rgba(0, 0, 0, 0.6) 78%,
      transparent 100%
    );
    filter: blur(10px);
  }

  /* ---- about ------------------------------------------------------------- */

  /* Two columns with a gutter down the middle for the beam. */
  .about {
    min-height: 100vh;
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      clamp(6rem, 16vw, 13rem)
      minmax(0, 0.62fr);
    align-items: center;
    padding: 12vh clamp(1.5rem, 6vw, 6rem);
    gap: 0;
  }
  .about__col {
    grid-column: 1;
    display: grid;
    gap: clamp(1.5rem, 4vh, 2.5rem);
    max-width: 52ch;
  }
  .toolkit {
    grid-column: 3;
    display: grid;
    gap: clamp(0.9rem, 2.4vh, 1.4rem);
    justify-items: end;
    text-align: right;
  }
  .toolkit__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.45rem, 1.4vh, 0.85rem);
    font-size: clamp(1rem, 1.55vw, 1.5rem);
    font-weight: 300;
    line-height: 1.25;
    color: color-mix(in oklab, var(--fg) 88%, transparent);
    text-shadow: 0 0 24px rgba(0, 0, 0, 0.85);
  }
  .toolkit__list li {
    position: relative;
    padding-right: 1.1em;
  }
  /* A hairline tick rather than a bullet: the list should read as a spec
     column, not as body copy with markers. */
  .toolkit__list li::after {
    content: "";
    position: absolute;
    right: 0;
    top: 0.62em;
    width: 0.55em;
    height: 1px;
    background: color-mix(in oklab, var(--fg) 32%, transparent);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(2.5rem, 8vh, 5rem);
    }
    .about__col { grid-column: 1; }
    .toolkit {
      grid-column: 1;
      justify-items: start;
      text-align: left;
    }
    .toolkit__list li { padding-right: 0; padding-left: 1.1em; }
    .toolkit__list li::after { right: auto; left: 0; }
  }
  .about__label { color: color-mix(in oklab, var(--fg) 42%, transparent); }
  .about__body {
    display: grid;
    gap: 1.1em;
    font-size: clamp(1.05rem, 1.7vw, 1.6rem);
    font-weight: 300;
    line-height: 1.5;
    color: color-mix(in oklab, var(--fg) 92%, transparent);
    text-shadow: 0 0 24px rgba(0, 0, 0, 0.8);
  }
  .about__body p { margin: 0; }

  .about__contact {
    display: grid;
    gap: clamp(0.75rem, 2vh, 1.25rem);
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
  }
  .about__links {
    list-style: none;
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
  }
  .about__links a {
    color: color-mix(in oklab, var(--fg) 78%, transparent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--fg) 22%, transparent);
    padding-bottom: 0.15em;
    transition: color 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  .about__links a:hover,
  .about__links a:focus-visible {
    color: var(--fg);
    border-color: var(--fg);
  }
  .about__cue {
    margin: clamp(0.5rem, 2vh, 1.5rem) 0 0;
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    font-style: italic;
    color: color-mix(in oklab, var(--fg) 55%, transparent);
  }

  @media (max-width: 860px) {
    .about {
      max-width: none;
      margin-inline: clamp(1.25rem, 6vw, 3rem);
    }
  }

  /* ---- threshold card ---------------------------------------------------- */

  .threshold {
    position: fixed;
    inset: 0;
    display: grid;
    place-content: center;
    pointer-events: none;
    opacity: 0;
    z-index: 2;
  }
  .threshold__word {
    margin: 0;
    font-size: clamp(2.5rem, 9vw, 8rem);
    font-weight: 300;
    font-style: italic;
    letter-spacing: 0.01em;
    /* Near-black rather than pure #000: on a 255 field a hair of lift keeps
       the serif's thin strokes from aliasing into hard stair-steps. */
    color: #0a0a0c;
  }

  /* Pinned near the floor of the viewport, one line, never wrapping. Its
     opacity is driven from the scroll position in JS, not by a transition —
     it must track the scroll rather than lag behind it. */
  .hero__sub {
    position: fixed;
    left: 50%;
    bottom: clamp(1.75rem, 5vh, 3.25rem);
    transform: translateX(-50%);
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1vw, 0.82rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.7em 1.4em;
    color: color-mix(in oklab, var(--fg) 78%, transparent);
    text-shadow: 0 0 16px rgba(0, 0, 0, 0.9), 0 0 34px rgba(0, 0, 0, 0.7);
    pointer-events: none;
    z-index: 1;
  }

  /* On a narrow viewport the single line would overflow, and the brief is
     explicit that it stays one line — so it shrinks rather than wraps. */
  @media (max-width: 560px) {
    .hero__sub {
      font-size: 0.58rem;
      letter-spacing: 0.08em;
    }
  }

  /* ---- project stop overlay ---------------------------------------------- */

  .stop {
    /* Base Y offset, so the reveal transform is written once and stays correct
       when the panel moves from vertically-centred to bottom-anchored. */
    --stop-y: -50%;
    position: fixed;
    top: 50%;
    width: min(30ch, 34vw);
    display: grid;
    gap: clamp(0.9rem, 2.2vh, 1.6rem);
    opacity: 0;
    will-change: opacity, transform;
  }
  .stop--right {
    right: clamp(1.5rem, 6vw, 6rem);
    text-align: right;
    justify-items: end;
  }
  .stop--left {
    left: clamp(1.5rem, 6vw, 6rem);
    text-align: left;
    justify-items: start;
  }
  .stop--left .stop__cta { justify-items: start; }
  .stop--left .stop__rule { transform-origin: left; }

  .stop__index { color: color-mix(in oklab, var(--fg) 45%, transparent); }

  .stop__title {
    margin: 0;
    font-size: clamp(2rem, 4.6vw, 3.75rem);
    color: #fff;
  }

  .stop__meta {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    color: color-mix(in oklab, var(--fg) 62%, transparent);
  }
  .stop__meta > div {
    display: grid;
    gap: 0.15rem;
  }
  .stop__meta dt {
    color: color-mix(in oklab, var(--fg) 34%, transparent);
  }
  .stop__meta dd { margin: 0; }

  .stop__cta {
    display: grid;
    gap: 0.5rem;
    justify-items: end;
    padding: 0;
    background: none;
    border: 0;
    color: var(--fg);
    cursor: pointer;
    text-transform: uppercase;
  }
  /* The rule is the whole interaction: it draws itself under the label rather
     than the label changing colour. Quiet, and it survives on a bright field. */
  .stop__rule {
    display: block;
    width: 100%;
    height: 1px;
    background: color-mix(in oklab, var(--fg) 30%, transparent);
    transform: scaleX(0.28);
    transform-origin: right;
    transition: transform 0.5s var(--ease), background-color 0.5s var(--ease);
  }
  .stop__cta:hover .stop__rule,
  .stop__cta:focus-visible .stop__rule {
    transform: scaleX(1);
    background: var(--fg);
  }

  .probe {
    position: fixed;
    left: clamp(1rem, 3vw, 2.5rem);
    bottom: clamp(1rem, 3vw, 2.5rem);
    pointer-events: none;
    color: color-mix(in oklab, var(--fg) 45%, transparent);
  }

  /* ---- fixed nav --------------------------------------------------------- */

  .nav {
    position: fixed;
    top: clamp(1rem, 2.5vw, 2rem);
    right: clamp(1rem, 3vw, 2.5rem);
    display: flex;
    align-items: flex-start;
    gap: clamp(0.5rem, 1.2vw, 1rem);
    /* Above the white-out card, which is z-index 2 — the nav is the one thing
       that must never be swallowed by the threshold. */
    z-index: 10;
  }

  .nav__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 0.85em;
    background: color-mix(in oklab, #000 55%, transparent);
    border: 1px solid color-mix(in oklab, var(--fg) 16%, transparent);
    border-radius: 999px;
    color: color-mix(in oklab, var(--fg) 82%, transparent);
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 1.1vw, 1.02rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: color 0.35s var(--ease), border-color 0.35s var(--ease),
      background-color 0.35s var(--ease);
  }
  .nav__btn:hover,
  .nav__btn:focus-visible {
    color: var(--fg);
    border-color: color-mix(in oklab, var(--fg) 45%, transparent);
    background: color-mix(in oklab, #000 72%, transparent);
  }
  .nav__btn svg {
    width: 1.05em;
    height: 1.05em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav__menu {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    min-width: 15rem;
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    display: grid;
    gap: 0.15rem;
    background: color-mix(in oklab, #000 78%, transparent);
    border: 1px solid color-mix(in oklab, var(--fg) 16%, transparent);
    border-radius: 0.85rem;
    backdrop-filter: blur(14px);
  }
  .nav__menu[hidden] { display: none; }
  .nav__menu button {
    width: 100%;
    text-align: right;
    padding: 0.55em 0.7em;
    background: none;
    border: 0;
    border-radius: 0.55rem;
    color: color-mix(in oklab, var(--fg) 72%, transparent);
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 400;
    cursor: pointer;
    transition: color 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .nav__menu button:hover,
  .nav__menu button:focus-visible {
    color: var(--fg);
    background: color-mix(in oklab, var(--fg) 8%, transparent);
  }

  @media (max-width: 560px) {
    .nav__label { display: none; }
    .nav__btn { padding: 0.55em; }
  }

  /* ---- detail mode ------------------------------------------------------- */

  .detail {
    position: fixed;
    inset: 0;
    display: grid;
    align-content: end;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.45s var(--ease);
    z-index: 5;
  }
  .detail[hidden] { display: none; }
  .detail.is-open { opacity: 1; }

  .detail__panel {
    pointer-events: auto;
    width: min(38ch, 40vw);
    margin: 0 0 clamp(3rem, 10vh, 7rem) clamp(1.5rem, 6vw, 6rem);
    display: grid;
    gap: clamp(0.8rem, 2vh, 1.3rem);
  }
  .detail__index { color: color-mix(in oklab, var(--fg) 45%, transparent); }
  .detail__title {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 3.4rem);
    color: #fff;
  }
  .detail__body {
    display: grid;
    gap: 0.9em;
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 1vw, 0.9rem);
    line-height: 1.65;
    letter-spacing: 0.02em;
    color: color-mix(in oklab, var(--fg) 74%, transparent);
  }
  .detail__body p { margin: 0; }

  .detail__back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin-top: 0.5rem;
    padding: 0.6em 1.1em;
    background: color-mix(in oklab, #000 55%, transparent);
    border: 1px solid color-mix(in oklab, var(--fg) 20%, transparent);
    border-radius: 999px;
    color: color-mix(in oklab, var(--fg) 85%, transparent);
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .detail__back:hover,
  .detail__back:focus-visible {
    color: var(--fg);
    border-color: color-mix(in oklab, var(--fg) 50%, transparent);
  }

  .detail__hint {
    position: absolute;
    right: clamp(1.5rem, 6vw, 6rem);
    bottom: clamp(1.5rem, 5vh, 3rem);
    color: color-mix(in oklab, var(--fg) 38%, transparent);
  }

  @media (max-width: 900px) {
    .detail__panel { width: auto; margin-right: clamp(1.5rem, 6vw, 6rem); }
    .detail__hint { display: none; }
  }

  /* Below the fold of a phone the object owns the frame; the panel drops to the
     bottom rather than fighting it for horizontal room. */
  @media (max-width: 640px) {
    .stop {
      --stop-y: 0%;
      top: auto;
      bottom: clamp(3.5rem, 12vh, 7rem);
      left: clamp(1.25rem, 6vw, 3rem);
      right: clamp(1.25rem, 6vw, 3rem);
      width: auto;
      text-align: left;
      justify-items: start;
    }
    .stop__cta { justify-items: start; }
    .stop__rule { transform-origin: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__hint { animation: none; opacity: 0.6; }
    .stop__rule { transition: none; }
  }
</style>

<script>
  import { initLightBeam } from '../scenes/light-beam';
  import { initNebula } from '../scenes/nebula';
  import { initStarfield } from '../scenes/starfield';
  import { initNomadStop } from '../scenes/nomad-stop';
  import { initShifuStop } from '../scenes/shifu-stop';
  import { initInspect } from '../scenes/inspect';
  import { onFrame, view } from '../lib/loop';
  import { warpTo } from '../lib/warp';
  import { detail, enterDetail, exitDetail, onDetailChange } from '../lib/detail';

  const probe = document.querySelector<HTMLElement>('[data-probe]');
  const heroSub = document.querySelector<HTMLElement>('[data-hero-sub]');
  const threshold = document.querySelector<HTMLElement>('[data-threshold]');
  const panels: Array<[string, HTMLElement | null]> = [
    ['nomad', document.querySelector<HTMLElement>('[data-stop="nomad"]')],
    ['shifu', document.querySelector<HTMLElement>('[data-stop="shifu"]')],
  ];

  // Null until the first frame decides, so the very first evaluation always
  // writes both aria-hidden and inert rather than short-circuiting.
  const panelOn: Record<string, boolean | null> = { nomad: null, shifu: null };
  for (const [, el] of panels) if (el) (el as any).inert = true;

  // ---- warp navigation -------------------------------------------------------
  // Wired outside boot() so the nav works even if the WebGL stage fails: the
  // scroll still happens, it simply does not streak.
  const menu = document.querySelector<HTMLElement>('[data-warp-menu]');
  const searchBtn = document.querySelector<HTMLButtonElement>('[data-warp-search]');

  const setMenu = (open: boolean) => {
    if (!menu || !searchBtn) return;
    menu.hidden = !open;
    searchBtn.setAttribute('aria-expanded', String(open));
  };

  document.querySelector('[data-warp-home]')?.addEventListener('click', () => {
    setMenu(false);
    warpTo(0);
  });

  searchBtn?.addEventListener('click', () => setMenu(Boolean(menu?.hidden)));

  for (const btn of document.querySelectorAll<HTMLElement>('[data-warp-to]')) {
    btn.addEventListener('click', () => {
      setMenu(false);
      warpTo(Number(btn.dataset.warpTo));
    });
  }

  // Escape closes, and click-away closes — a menu that can only be dismissed by
  // its own button is a trap on a page with no other chrome.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
  document.addEventListener('pointerdown', (e) => {
    if (menu && !menu.hidden && !(e.target as Element)?.closest('.nav')) setMenu(false);
  });

  // ---- detail mode -----------------------------------------------------------
  const COPY: Record<string, { index: string; title: string; body: string[] }> = {
    nomad: {
      index: '01 — Detail',
      title: 'Nomad Brewer',
      body: [
        'A modular outdoor coffee and tea brewing device. The body separates into stacked components that travel nested and assemble by feel, without a manual.',
        'Each joint is a twist-lock: a quarter turn seats and seals it, so the whole stack can be built and struck with cold hands and one free hand.',
        'Dark matte ceramic for the structure, frosted glass for the vessels — you need to read the brew level without opening anything.',
      ],
    },
    shifu: {
      index: '02 — Detail',
      title: 'Shifu 26',
      body: [
        'Formula Student bodywork for Ozu Racing, developed in the Composites & Aerodynamics sub-team.',
        'Carbon fibre skins over a steel spaceframe, with the enamel details kept to the minimum the regulations allow.',
        'The model shown is the full assembly: 1,498 CAD bodies consolidated by material into carbon, steel and enamel, then decimated for the web without changing a single material definition.',
      ],
    },
  };

  const detailEl = document.querySelector<HTMLElement>('[data-detail]');
  const detailIndex = document.querySelector<HTMLElement>('[data-detail-index]');
  const detailTitle = document.querySelector<HTMLElement>('[data-detail-title]');
  const detailBody = document.querySelector<HTMLElement>('[data-detail-body]');

  const fillDetail = (id: string) => {
    const c = COPY[id];
    if (!c || !detailIndex || !detailTitle || !detailBody) return;
    detailIndex.textContent = c.index;
    detailTitle.textContent = c.title;
    detailBody.replaceChildren(
      ...c.body.map((t) => {
        const p = document.createElement('p');
        p.textContent = t;
        return p;
      }),
    );
  };

  // The overlay appears at the far end of the portal, not at the click — the
  // transition is the point, and text sliding in over a moving camera would
  // undercut it.
  onDetailChange((s) => {
    if (!detailEl) return;
    if (s.mode === 'active') {
      detailEl.hidden = false;
      requestAnimationFrame(() => detailEl.classList.add('is-open'));
    } else {
      detailEl.classList.remove('is-open');
      if (s.mode === 'idle') {
        // Wait out the fade before removing from the a11y tree.
        setTimeout(() => {
          if (detail.mode === 'idle') detailEl.hidden = true;
        }, 460);
      }
    }
  });

  for (const btn of document.querySelectorAll<HTMLElement>('[data-stop-cta]')) {
    btn.addEventListener('click', () => {
      const id = btn.dataset.stopCta;
      if (!id) return;
      fillDetail(id);
      enterDetail(id);
    });
  }

  document.querySelector('[data-detail-back]')?.addEventListener('click', () => exitDetail());
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && detail.mode === 'active') exitDetail();
  });

  const boot = async () => {
    const api = (window as any).__scene;
    if (!api || (window as any).__beamScene) return;

    try {
      const beam = await initLightBeam(api);
      (window as any).__beamScene = beam;

      // The permanent atmosphere, in draw order beneath everything. Neither of
      // these belongs to the beam group, so the white-out kill cannot reach
      // them — they are what the showcase is staged in.
      const nebula = initNebula(api, beam);
      (window as any).__nebula = nebula;

      const stars = initStarfield(api, beam);
      (window as any).__starfield = stars;

      initInspect(api).then((ins) => {
        (window as any).__inspectHandle = ins;
      });

      initNomadStop(api, beam)
        .then((nomad) => {
          (window as any).__nomadStop = nomad;
        })
        .catch((err) => {
          if (probe) probe.textContent = 'stop 01 · model failed — see console';
          console.error('[nomad]', err);
        });

      // SHIFU loads a 539KB model, so it must not block the rest of the scene
      // coming up. It arms itself whenever it lands; the stop is 7.4vh down the
      // track and nothing before that depends on it.
      initShifuStop(api, beam)
        .then((shifu) => {
          (window as any).__shifuStop = shifu;
          if (probe) {
            probe.textContent =
              `beam · shifu ${shifu.info.meshes} meshes · ` +
              `${shifu.info.triangles.toLocaleString()} tris · native materials`;
          }
        })
        .catch((err) => {
          if (probe) probe.textContent = 'stop 02 · model failed — see console';
          console.error('[shifu]', err);
        });

      if (probe) probe.textContent = 'beam · live · loading shifu';

      onFrame(() => {
        const svh = view.scrollY / Math.max(1, view.vh);

        // Subtitle: full at rest, gone by 0.15vh. Authored in viewport-heights
        // to match the brief directly rather than in normalised progress,
        // which would change meaning every time the track length changes.
        if (heroSub) {
          const k = Math.min(1, svh / 0.15);
          heroSub.style.opacity = String(1 - k * k);
        }

        // Where the portal is aiming. Recomputed every frame rather than
        // captured on click, because the stop's own reveal animation is still
        // moving the group while the portal runs — a captured point would be
        // stale by the time the camera arrived.
        const stopHandle =
          detail.stopId === 'nomad'
            ? (window as any).__nomadStop
            : detail.stopId === 'shifu'
              ? (window as any).__shifuStop
              : null;
        if (stopHandle) {
          const g = stopHandle.group;
          (window as any).__detailTarget = {
            x: g.position.x,
            y: g.position.y,
            z: g.position.z,
            // Frame the whole model with a little air around it.
            dist: Math.max(3, stopHandle.radius * 2.1),
          };
        }

        // "Welcome." belongs to the white plateau and nowhere else. Keyed to
        // the dive rather than to scroll so it can never drift out of the
        // white — it fades in over the last of the blow-out and is gone before
        // the frame has any colour to compete with.
        if (threshold) {
          const d = beam.diveRef.value;
          const k = Math.max(0, Math.min(1, (d - 0.82) / 0.16));
          threshold.style.opacity = String(k * k * (3 - 2 * k));
        }

        // The scene is the single authority on stop presence — the panel reads
        // it rather than recomputing from scroll, so type and geometry can
        // never disagree about where the stop is.
        for (const [id, el] of panels) {
          if (!el) continue;
          const f = beam.focusOf[id] ?? 0;
          // The stop's focus is already high on the approach to the dive — so
          // ungated the panel would fade in BEFORE the threshold, be wiped by
          // the white-out, then fade in a second time. revealRef keeps it shut
          // until the camera is coming back out.
          const eased = f * f * (3 - 2 * f) * beam.revealRef.value;
          el.style.opacity = String(eased);
          el.style.transform = `translate3d(0, calc(var(--stop-y) + ${(1 - eased) * 18}px), 0)`;
          // Tracked in JS, not read back off the attribute. Reading the
          // attribute meant the initial state (already aria-hidden in the
          // markup) matched on the first frame, the branch never ran, and
          // `inert` was never set — leaving an invisible panel in the tab
          // order until the first time the stop toggled.
          const on = eased > 0.5;
          if (panelOn[id] !== on) {
            panelOn[id] = on;
            el.setAttribute('aria-hidden', String(!on));
            (el as any).inert = !on;
          }
        }
      });
    } catch (err) {
      if (probe) probe.textContent = 'beam · failed — see console';
      console.error('[beam]', err);
    }
  };

  document.addEventListener('stage:ready', boot);
  if ((window as any).__scene?.ready) boot();

  // The inline greeting script runs at parse time and so does not re-run after
  // a ClientRouter swap, which would leave a stale time of day on any internal
  // navigation back to this page.
  document.addEventListener('astro:after-swap', () => (window as any).__setGreeting?.());
</script>
