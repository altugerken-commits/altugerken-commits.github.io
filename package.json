{
  "name": "portfolio-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && tsc -p remotion/tsconfig.json --noEmit",
    "preview": "astro preview",
    "astro": "astro",
    "media:studio": "remotion studio remotion/index.ts",
    "media:render": "npm run media:webm && npm run media:mp4 && npm run media:poster",
    "media:webm": "remotion render remotion/index.ts DraftingStrip public/media/drafting-strip.webm --codec=vp9",
    "media:mp4": "remotion render remotion/index.ts DraftingStrip public/media/drafting-strip.mp4 --codec=h264",
    "media:poster": "remotion still remotion/index.ts DraftingStrip public/media/drafting-strip.png --frame=60"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.6",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@gltf-transform/cli": "^4.4.2",
    "@remotion/cli": "^4.0.507",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.4",
    "remotion": "^4.0.507",
    "typescript": "^6.0.3"
  }
}
